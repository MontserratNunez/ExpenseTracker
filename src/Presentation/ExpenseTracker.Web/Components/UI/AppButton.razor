<button type="@Type"
        class="@CssClasses"
        disabled="@(Disabled || Loading)"
        aria-busy="@(Loading ? "true" : null)"
        aria-label="@AriaLabel"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @if (Loading)
    {
        <span class="btn-app__spinner" aria-hidden="true"></span>
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <AppIcon Name="@Icon" Size="16" />
    }
    @ChildContent
</button>

@code {
    public enum ButtonVariant { Primary, Secondary, Ghost, Danger }

    public enum ButtonSize { Sm, Md }

    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Md;

    /// <summary>Bootstrap Icons name shown before the text (use the constants in <see cref="Icons"/>).</summary>
    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string Type { get; set; } = "button";

    /// <summary>Shows a spinner, disables the button and marks it busy for screen readers.</summary>
    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Required when the button has no text (icon only): it is the only name a screen reader gets.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string CssClasses => string.Join(" ", new[]
    {
        "btn-app",
        $"btn-app--{Variant.ToString().ToLower()}",
        $"btn-app--{Size.ToString().ToLower()}",
        ChildContent is null ? "btn-app--icon" : null,
        Class
    }.Where(c => !string.IsNullOrWhiteSpace(c)));

    /// <summary>Any other attribute (id, title, form, data-*) goes to the button element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
