@using System.Linq.Expressions

@* An on/off switch (a checkbox with role="switch"). The label sits next to it, so it does not use FormField. *@
<div class="form-field @Class">
    <label class="toggle" for="@Id">
        <InputCheckbox id="@Id" class="toggle__input" role="switch" disabled="@Disabled"
                       aria-describedby="@(string.IsNullOrEmpty(Hint) ? null : $"{Id}-hint")"
                       Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" />
        <span class="toggle__track" aria-hidden="true"></span>
        <span class="toggle__label">@Label</span>
    </label>
    @if (!string.IsNullOrEmpty(Hint))
    {
        <div class="form-field__hint" id="@($"{Id}-hint")">@Hint</div>
    }
</div>

@code {
    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<bool>>? ValueExpression { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? Class { get; set; }

    protected override void OnInitialized() => Id ??= FieldId.Next();
}
