@typeparam TValue
@using System.Linq.Expressions

@* A numeric field (int, decimal, nullable versions). For money use MoneyInput instead. *@
<FormField Label="@Label" InputId="@Id" Hint="@Hint" Class="@Class">
    <ChildContent>
        @if (string.IsNullOrEmpty(Suffix))
        {
            <InputNumber TValue="TValue" DisplayName="@Label" id="@Id" class="field" placeholder="@Placeholder" disabled="@Disabled"
                         step="@Step" min="@Min" max="@Max" inputmode="@InputMode"
                         ParsingErrorMessage="El campo {0} debe ser un número."
                         aria-describedby="@(string.IsNullOrEmpty(Hint) ? null : $"{Id}-hint")"
                         Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" />
        }
        else
        {
            <div class="field-group">
                <InputNumber TValue="TValue" DisplayName="@Label" id="@Id" class="field-group__control" placeholder="@Placeholder" disabled="@Disabled"
                             step="@Step" min="@Min" max="@Max" inputmode="@InputMode"
                             ParsingErrorMessage="El campo {0} debe ser un número."
                             aria-describedby="@(string.IsNullOrEmpty(Hint) ? null : $"{Id}-hint")"
                             Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" />
                <span class="field-group__affix field-group__affix--end" aria-hidden="true">@Suffix</span>
            </div>
        }
    </ChildContent>
    <Validation>
        @if (ValueExpression is not null)
        {
            <ValidationMessage For="ValueExpression" class="validation-message" />
        }
    </Validation>
</FormField>

@code {
    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<TValue?>>? ValueExpression { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Hint { get; set; }

    /// <summary>Text shown after the number inside the field, e.g. "%".</summary>
    [Parameter]
    public string? Suffix { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>"any" allows decimals; use "1" for whole numbers.</summary>
    [Parameter]
    public string Step { get; set; } = "any";

    [Parameter]
    public string? Min { get; set; }

    [Parameter]
    public string? Max { get; set; }

    [Parameter]
    public string InputMode { get; set; } = "decimal";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? Class { get; set; }

    protected override void OnInitialized() => Id ??= FieldId.Next();
}
