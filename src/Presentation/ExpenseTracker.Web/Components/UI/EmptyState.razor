@* What a list shows when it has nothing yet: an icon, what is missing and, ideally, the next step. *@
<div class="empty-state @Class">
    <span class="empty-state__icon"><AppIcon Name="@Icon" Size="28" /></span>
    <h2 class="empty-state__title">@Title</h2>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="empty-state__description">@Description</p>
    }
    @if (Action is not null)
    {
        <div class="empty-state__action">@Action</div>
    }
</div>

@code {
    [Parameter]
    public string Icon { get; set; } = Icons.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    /// <summary>Usually a primary button that creates the first item.</summary>
    [Parameter]
    public RenderFragment? Action { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
