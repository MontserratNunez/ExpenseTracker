@page "/plan"
@using ExpenseTracker.Core.Application.DTOs.Budget
@using ExpenseTracker.Core.Application.Helpers
@using ExpenseTracker.Core.Application.Interfaces
@using ExpenseTracker.Core.Application.Services
@using ExpenseTracker.Core.Domain.Enums
@using ExpenseTracker.Web.Services
@inject BudgetService BudgetService
@inject BudgetPlanService PlanService
@inject CurrencyService CurrencyService
@inject IDateProvider DateProvider
@inject ShortcutService Shortcuts
@implements IDisposable

<PageTitle>Plan · @UiLabels.MonthName(month).ToLower() @year · Expense Tracker</PageTitle>

<PageHeader Title="Plan">
    <Actions>
        <AppButton Variant="@(CanEdit ? AppButton.ButtonVariant.Secondary : AppButton.ButtonVariant.Primary)"
                   Icon="@Icons.Add" OnClick="StartNewAsync" Disabled="@loading">Nuevo plan</AppButton>
        @if (CanEdit)
        {
            <AppButton OnClick="StartEditAsync" Disabled="@loading">Editar plan</AppButton>
        }
    </Actions>
</PageHeader>

<div class="plan-toolbar">
    <MonthNavigator Year="year" Month="month" OnChange="OnMonthChanged" MaxMonthsAhead="MonthsAhead" />
    @if (!loading && plan is not null)
    {
        <div class="plan-toolbar__plan">
            @if (plan.HasPlan)
            {
                <Badge Icon="@Icons.Plans">@plan.PlanName · @PlanText.Period(plan.PlanFrom!.Value, plan.PlanTo)</Badge>
            }
            else
            {
                <Badge Tone="Badge.BadgeTone.Gray" Icon="@Icons.Plans">Sin plan</Badge>
            }
            @if (SelectedPlan is { IsPast: false } selected)
            {
                <AppButton Variant="AppButton.ButtonVariant.Ghost" Size="AppButton.ButtonSize.Sm" OnClick="() => StartDetailsAsync(selected)">Nombre y vigencia</AppButton>
                @if (selected.IsCurrent)
                {
                    <AppButton Variant="AppButton.ButtonVariant.Ghost" Size="AppButton.ButtonSize.Sm" OnClick="() => StartFinish(selected)">Finalizar</AppButton>
                }
                else
                {
                    <AppButton Variant="AppButton.ButtonVariant.Ghost" Size="AppButton.ButtonSize.Sm" Icon="@Icons.Delete" OnClick="() => showDelete = true">Eliminar</AppButton>
                }
            }
        </div>
    }
</div>

<ErrorAlert @bind-Message="error" />
<SuccessToast Message="@message" />

@if (loading)
{
    <Skeleton Lines="5" Height="3rem" />
}
else if (plan is not null)
{
    @if (plans.Count > 0)
    {
        <PlanTimeline Plans="plans" CurrentMonth="CurrentMonth" SelectedPlanId="plan.PlanId" OnSelect="ShowPlanAsync" />
    }

    @if (!plan.HasPlan)
    {
        @if (IsPastMonth)
        {
            <EmptyState Icon="@Icons.Budget" Title="@($"No tenías un plan en {ViewedMonthText}")"
                        Description="@(plan.OutOfPlan.Count > 0 ? "Los meses sin plan no se evalúan: abajo ves lo que gastaste." : "Los meses sin plan no se evalúan. Tampoco registraste gastos ese mes.")" />
        }
        else
        {
            <EmptyState Icon="@Icons.Budget" Title="@(plans.Count == 0 ? "Aún no tienes un plan" : $"No tienes un plan para {ViewedMonthText}")"
                        Description="Reparte tus ingresos por categoría para ver si lo estás cumpliendo.">
                <Action><AppButton OnClick="StartNewAsync">Crear mi plan</AppButton></Action>
            </EmptyState>
        }
    }
    else
    {
    <div class="plan-summary">
        <StatCard Label="Asignado" Amount="plan.TotalAssigned" Currency="baseCurrency" Large="true">
            <p class="plan-note @(plan.IsOverAssigned ? "plan-note--over" : null)">
                @plan.AssignedPercentOfIncome.ToString("0.#") % de tus ingresos
                <span aria-hidden="true">&nbsp;·&nbsp;</span>
                @if (plan.Unassigned >= 0)
                {
                    <span>sin asignar <MoneyText Amount="plan.Unassigned" Currency="baseCurrency" /></span>
                }
                else
                {
                    <span>de más <MoneyText Amount="-plan.Unassigned" Currency="baseCurrency" /></span>
                }
            </p>
        </StatCard>
        <StatCard Label="Estimado a fin de mes" Amount="plan.TotalEstimated" Currency="baseCurrency" Large="true">
            <p class="plan-note">
                Gastado <MoneyText Amount="plan.TotalSpent" Currency="baseCurrency" />
                <span aria-hidden="true">&nbsp;·&nbsp;</span>
                pendiente <MoneyText Amount="plan.TotalPending" Currency="baseCurrency" />
            </p>
        </StatCard>
    </div>

    @if (plan.IsOverAssigned)
    {
        <InlineAlert Tone="InlineAlert.AlertTone.Warning" Class="plan-alert">
            Asignaste más de lo que ingresas este mes:
            <MoneyText Amount="plan.TotalAssigned" Currency="baseCurrency" /> asignados frente a
            <MoneyText Amount="plan.Income" Currency="baseCurrency" /> de ingresos.
        </InlineAlert>
    }

    @foreach (var warning in plan.Warnings)
    {
        <InlineAlert Tone="InlineAlert.AlertTone.Warning" Class="plan-alert">@warning</InlineAlert>
    }

    @if (plan.Categories.Count == 0)
    {
        <EmptyState Icon="@Icons.Budget" Title="Este plan aún no tiene categorías" Description="Define cuánto quieres gastar en cada una.">
            <Action>
                @if (CanEdit)
                {
                    <AppButton OnClick="StartEditAsync">Definir categorías</AppButton>
                }
            </Action>
        </EmptyState>
    }
    else
    {
        <ul class="plan-list" aria-label="Categorías del plan">
            @foreach (var category in plan.Categories)
            {
                var c = category;
                var editing = editingCategoryId == c.CategoryId;
                <li class="plan-row">
                    <div class="plan-row__who">
                        <CategoryChip Name="@c.CategoryName" Color="@c.CategoryColor" Icon="@c.CategoryIcon" />
                        <div class="plan-row__assigned">
                            @if (editing)
                            {
                                var percent = c.AllocationType == AllocationType.PercentageOfIncome;
                                <span class="plan-edit">
                                    <input type="text" inputmode="decimal" class="field field--sm plan-edit__input @(editError is null ? null : "invalid")"
                                           aria-label="@(percent ? $"Porcentaje asignado a {c.CategoryName}" : $"Monto asignado a {c.CategoryName}")"
                                           aria-describedby="@(editError is null ? null : "plan-edit-error")"
                                           @ref="editInput" @bind="editText" @bind:event="oninput"
                                           @onkeydown="OnEditKeyAsync" @onblur="CancelInline" />
                                    @if (percent)
                                    {
                                        <span aria-hidden="true">%</span>
                                    }
                                </span>
                            }
                            else if (!CanEdit)
                            {
                                <span>de <MoneyText Amount="c.Assigned" Currency="baseCurrency" /></span>
                            }
                            else
                            {
                                <button type="button" class="plan-row__edit" @onclick="() => StartInline(c)"
                                        title="@EditTitle(c)">
                                    <span class="sr-only">@($"Editar lo asignado a {c.CategoryName}: ")</span>de <MoneyText Amount="c.Assigned" Currency="baseCurrency" />
                                    @if (c.AllocationType == AllocationType.PercentageOfIncome)
                                    {
                                        <span class="plan-row__kind" title="@BaseText(c)">(@c.Value.ToString("0.##") % de ingreso)</span>
                                    }
                                    <AppIcon Name="@Icons.Edit" Size="12" Class="plan-row__pencil" />
                                </button>
                            }
                        </div>
                    </div>

                    <ProgressBar Segments="PlanBars.Segments(c)" Marker="PlanBars.EstimateMarker(c)" MarkerLabel="Estimado a fin de mes"
                                 Limit="PlanBars.LimitMarker(c)" LimitLabel="Límite asignado" Height="8" Label="@PlanBars.Label(c)" />

                    <div class="plan-row__status @PlanBars.HealthClass(c.Health)">
                        <AppIcon Name="@PlanBars.HealthIcon(c.Health)" Size="16" />
                        <span>
                            @if (c.Available < 0)
                            {
                                <text>Ya te pasaste por <MoneyText Amount="-c.Available" Currency="baseCurrency" /></text>
                            }
                            else if (c.EstimatedOverrun > 0)
                            {
                                <text>Te pasarás por ~<MoneyText Amount="c.EstimatedOverrun" Currency="baseCurrency" /></text>
                            }
                            else if (c.Health == PlanHealth.Yellow)
                            {
                                <text>Cerca del límite</text>
                            }
                            else
                            {
                                <MoneyText Amount="c.Available" Currency="baseCurrency" /> <text>disponibles</text>
                            }
                        </span>
                    </div>

                    @if (editing && editError is not null)
                    {
                        <p class="plan-row__error validation-message" id="plan-edit-error" role="alert">@editError</p>
                    }
                </li>
            }
        </ul>
        <p class="plan-legend">
            Barra: gastado (sólido), pendiente (rayado), línea continua el estimado a fin de mes y línea punteada el límite asignado.
            @if (CanEdit)
            {
                <text>Haz clic en lo asignado para editarlo: <kbd>Enter</kbd> guarda y <kbd>Esc</kbd> cancela.</text>
            }
        </p>
    }
    }

    @if (plan.OutOfPlan.Count > 0)
    {
        <section class="plan-outside" aria-labelledby="plan-outside-title">
            <h2 id="plan-outside-title">@(plan.HasPlan ? "Fuera del plan" : "Gasto por categoría")</h2>
            <ul class="home-list">
                @foreach (var item in plan.OutOfPlan)
                {
                    <li class="plan-outside__row">
                        <CategoryChip Name="@item.CategoryName" Color="@item.CategoryColor" />
                        <span>
                            <MoneyText Amount="item.Spent" Currency="baseCurrency" />
                            @if (item.Pending > 0)
                            {
                                <span> + <MoneyText Amount="item.Pending" Currency="baseCurrency" /> pendiente</span>
                            }
                        </span>
                    </li>
                }
            </ul>
        </section>
    }
}

<AllocationForm Visible="showEditor" Editor="editor" Rows="editRows" BaseCurrency="baseCurrency"
                Note="@editorNote" Error="@formError" OnSave="SaveAsync" OnCancel="CloseEditor" />

<PlanForm Visible="showPlanForm" IsNew="@(detailsPlan is null)" Model="planForm" CurrentMonth="CurrentMonth"
          VersionFrom="@(detailsPlan is { EditCreatesVersion: true } ? CurrentMonth : null)" Plans="plans" Preview="preview"
          Error="@formError" OnPeriodChanged="RefreshPreviewAsync" OnSave="SavePlanAsync" OnCancel="ClosePlanForm" />

<ConfirmDialog @bind-Visible="showFinish" Title="Finalizar plan" ConfirmText="Finalizar" OnConfirm="FinishAsync">
    <p>«@SelectedPlan?.Name» se aplicará hasta el final del mes que elijas. Los meses anteriores no cambian.</p>
    <MonthYearSelect Label="Último mes" @bind-Value="finishMonth" FirstYear="CurrentMonth.Year" />
</ConfirmDialog>

<ConfirmDialog @bind-Visible="showDelete" Title="Eliminar plan" ConfirmText="Eliminar"
               Message="@($"Se eliminará «{SelectedPlan?.Name}» y sus asignaciones.")" OnConfirm="DeletePlanAsync" />

@code {
    private bool loading = true;
    private string? error;
    private string? message;
    private string? formError;

    private int year;
    private int month;
    private Currency baseCurrency = Currency.DOP;
    private PlanStatusDto? plan;

    private List<BudgetPlanDto> plans = new();

    private bool showEditor;
    private AllocationEditorDto? editor;
    private List<AllocationRowDto> editRows = new();
    private int editorPlanId;
    private string? editorNote;

    // "Nuevo plan" (detailsPlan null) and "Nombre y vigencia".
    private bool showPlanForm;
    private BudgetPlanDto? detailsPlan;
    private PlanFormModel planForm = new();
    private PlanPeriodPreview? preview;

    private bool showFinish;
    private DateOnly finishMonth;
    private bool showDelete;

    /// <summary>How far ahead the page can go when there is no plan further away.</summary>
    private const int MinMonthsAhead = 1;

    private DateOnly CurrentMonth => new(DateProvider.Today.Year, DateProvider.Today.Month, 1);

    private bool IsPastMonth => new DateOnly(year, month, 1) < CurrentMonth;

    private string ViewedMonthText => $"{UiLabels.MonthName(month).ToLower()} {year}";

    private BudgetPlanDto? SelectedPlan => plans.FirstOrDefault(p => p.Id == plan?.PlanId);

    // Past months are history: they are shown as they were evaluated.
    private bool CanEdit => !loading && !IsPastMonth && SelectedPlan is { IsPast: false };

    // The navigation reaches every month where some plan starts or ends.
    private int MonthsAhead => plans
        .Select(p => p.EffectiveTo ?? p.EffectiveFrom)
        .Select(d => (d.Year - CurrentMonth.Year) * 12 + d.Month - CurrentMonth.Month)
        .Append(MinMonthsAhead)
        .Max();

    // Inline edit of one category's assigned value.
    private int? editingCategoryId;
    private string editText = string.Empty;
    private string? editError;
    private bool focusEdit;
    private ElementReference editInput;

    private IDisposable? shortcutSubscription;

    public void Dispose() => shortcutSubscription?.Dispose();

    // The left and right arrows change the month, up to one month after the current one.
    private async Task OnShortcutAsync(ShortcutEventArgs e)
    {
        if (loading || showEditor || showPlanForm || showFinish || showDelete || e.Key is not ("ArrowLeft" or "ArrowRight"))
            return;

        var index = year * 12 + (month - 1) + (e.Key == "ArrowLeft" ? -1 : 1);
        var today = DateProvider.Today;
        if (index > today.Year * 12 + today.Month - 1 + MonthsAhead)
            return;

        e.Handled = true;
        await OnMonthChanged((index / 12, index % 12 + 1));
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        var today = DateProvider.Today;
        shortcutSubscription = Shortcuts.Subscribe(OnShortcutAsync);
        year = today.Year;
        month = today.Month;

        await RunAsync(LoadAsync);
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusEdit)
        {
            focusEdit = false;
            await editInput.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        baseCurrency = await CurrencyService.GetBaseCurrencyAsync();
        plans = await PlanService.GetTimelineAsync();
        plan = await BudgetService.GetPlanStatusAsync(year, month);
    }

    private async Task OnMonthChanged((int Year, int Month) value)
    {
        year = value.Year;
        month = value.Month;
        message = null;
        error = null;
        CancelInline();
        loading = true;
        await RunAsync(LoadAsync);
        loading = false;
    }

    /// <summary>"10 % de RD$ 50,000.00 (Sueldo trabajo, nov 2026)".</summary>
    private string? BaseText(CategoryPlanDto c)
        => c.AllocationType != AllocationType.PercentageOfIncome
            ? null
            : $"{c.Value:0.##} % de {MoneyFormatter.Format(c.BaseAmount, baseCurrency)} " +
              $"({c.BaseName ?? "todos los ingresos"}, {UiLabels.MonthYear(new DateOnly(year, month, 1))})";

    private string EditTitle(CategoryPlanDto c)
        => BaseText(c) is { } text ? $"{text}. Clic para editar" : "Clic para editar";

    // ---------- Inline edit ----------


    private void StartInline(CategoryPlanDto category)
    {
        error = null;
        message = null;
        editError = null;
        editingCategoryId = category.CategoryId;
        // A percentage is edited as a percentage, an amount as an amount.
        editText = category.AllocationType == AllocationType.PercentageOfIncome
            ? category.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)
            : MoneyParser.Format(category.Value);
        focusEdit = true;
    }

    private void CancelInline()
    {
        editingCategoryId = null;
        editError = null;
    }

    private async Task OnEditKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CancelInline();
        else if (e.Key == "Enter")
            await SaveInlineAsync();
    }

    private async Task SaveInlineAsync()
    {
        if (editingCategoryId is not { } categoryId || plan?.PlanId is not { } planId)
            return;

        if (!MoneyParser.TryParse(editText, out var value, out var parseError))
        {
            editError = parseError;
            return;
        }

        try
        {
            var savedId = await PlanService.SetValueAsync(planId, categoryId, value);
            CancelInline();
            message = SavedMessage(planId, savedId);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            editError = ex.Message;
        }
    }

    // ---------- Edit plan ----------

    private async Task StartEditAsync()
    {
        error = null;
        message = null;
        formError = null;
        CancelInline();
        if (SelectedPlan is not { } selected)
            return;

        await OpenEditorAsync(selected.Id, selected.EditCreatesVersion);
    }

    private async Task OpenEditorAsync(int planId, bool createsVersion)
    {
        editorPlanId = planId;
        editorNote = createsVersion
            ? $"Los cambios aplican desde {UiLabels.MonthYear(CurrentMonth)}; los meses anteriores no cambian."
            : null;
        await RunAsync(async () =>
        {
            editor = await PlanService.GetEditorAsync(planId);
            // Work on copies so cancelling discards the changes.
            editRows = editor.Rows.Select(r => new AllocationRowDto
            {
                CategoryId = r.CategoryId,
                CategoryName = r.CategoryName,
                CategoryColor = r.CategoryColor,
                IsActive = r.IsActive,
                AllocationType = r.AllocationType,
                Value = r.Value,
                IncomeSourceId = r.IncomeSourceId
            }).ToList();
            showEditor = true;
        });
    }

    private async Task SaveAsync()
    {
        formError = null;
        try
        {
            var inputs = editRows.Select(r => new AllocationInput
            {
                CategoryId = r.CategoryId,
                AllocationType = r.AllocationType,
                Value = r.Value,
                IncomeSourceId = r.IncomeSourceId
            }).ToList();

            var current = plans.First(p => p.Id == editorPlanId);
            var savedId = await PlanService.UpdateAsync(editorPlanId, new BudgetPlanInput
            {
                Name = current.Name,
                EffectiveFrom = current.EffectiveFrom,
                EffectiveTo = current.EffectiveTo,
                Allocations = inputs
            });
            showEditor = false;
            message = SavedMessage(editorPlanId, savedId);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            formError = ex.Message;
        }
    }

    private void CloseEditor()
    {
        showEditor = false;
        formError = null;
    }

    private string SavedMessage(int planId, int savedId)
        => planId == savedId
            ? "Plan guardado."
            : $"Plan guardado. Los meses anteriores a {UiLabels.MonthYear(CurrentMonth)} no cambian.";

    private async Task StartNewAsync()
    {
        ResetMessages();
        detailsPlan = null;
        // Looking at a future month without plan suggests starting there.
        var viewed = new DateOnly(year, month, 1);
        var start = plan?.HasPlan == false && viewed > CurrentMonth ? viewed : CurrentMonth;
        planForm = new PlanFormModel
        {
            Name = $"Plan {start.Year}",
            Start = StartOption(start),
            FromMonth = start,
            EndMonth = start,
            CopyFromPlanId = null
        };
        await OpenPlanFormAsync();
    }

    private async Task StartDetailsAsync(BudgetPlanDto selected)
    {
        ResetMessages();
        detailsPlan = selected;
        planForm = new PlanFormModel
        {
            Name = selected.Name,
            Start = StartOption(selected.EffectiveFrom),
            FromMonth = selected.EffectiveFrom,
            HasEnd = selected.EffectiveTo is not null,
            EndMonth = selected.EffectiveTo is { } end ? new DateOnly(end.Year, end.Month, 1) : CurrentMonth
        };
        await OpenPlanFormAsync();
    }

    private PlanStart StartOption(DateOnly start)
        => start == CurrentMonth ? PlanStart.ThisMonth
            : start == CurrentMonth.AddMonths(1) ? PlanStart.NextMonth
            : PlanStart.FromMonth;

    private async Task OpenPlanFormAsync()
    {
        showPlanForm = true;
        await RefreshPreviewAsync();
    }

    private async Task RefreshPreviewAsync()
    {
        formError = null;
        try
        {
            preview = await PlanService.PreviewAsync(planForm.ToInput(CurrentMonth), detailsPlan?.Id);
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            preview = null;
            formError = ex.Message;
        }
    }

    private async Task SavePlanAsync()
    {
        formError = null;
        try
        {
            var input = planForm.ToInput(CurrentMonth);
            if (detailsPlan is { } edited)
            {
                var savedId = await PlanService.UpdateAsync(edited.Id, input);
                showPlanForm = false;
                message = SavedMessage(edited.Id, savedId);
                await LoadAsync();
                return;
            }

            var notice = preview?.Notice;
            var newId = await PlanService.CreateAsync(input);
            showPlanForm = false;
            message = notice is null ? "Plan creado." : $"Plan creado. {notice}";

            // Show the month where the new plan starts and, if it is empty, ask for its categories.
            var start = input.EffectiveFrom;
            (year, month) = (start.Year, start.Month);
            await LoadAsync();
            if (input.CopyFromPlanId is null)
                await OpenEditorAsync(newId, createsVersion: false);
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            formError = ex.Message;
        }
    }

    private void ClosePlanForm()
    {
        showPlanForm = false;
        formError = null;
    }

    private void StartFinish(BudgetPlanDto selected)
    {
        ResetMessages();
        var viewed = new DateOnly(year, month, 1);
        finishMonth = viewed > CurrentMonth ? viewed : CurrentMonth;
        showFinish = true;
    }

    private async Task FinishAsync()
    {
        if (SelectedPlan is not { } selected)
            return;

        await RunAsync(async () =>
        {
            await PlanService.EndAsync(selected.Id, finishMonth);
            message = $"El plan terminará en {UiLabels.MonthYear(finishMonth)}.";
            await LoadAsync();
        });
    }

    private async Task DeletePlanAsync()
    {
        if (SelectedPlan is not { } selected)
            return;

        await RunAsync(async () =>
        {
            await PlanService.DeleteAsync(selected.Id);
            message = "Plan eliminado.";
            await LoadAsync();
        });
    }

    private Task ShowPlanAsync(BudgetPlanDto selected)
    {
        var target = selected.IsCurrent ? CurrentMonth
            : selected.IsFuture ? selected.EffectiveFrom
            : selected.EffectiveTo!.Value;
        return OnMonthChanged((target.Year, target.Month));
    }

    private void ResetMessages()
    {
        error = null;
        message = null;
        formError = null;
        CancelInline();
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            error = ex.Message;
        }
    }
}
