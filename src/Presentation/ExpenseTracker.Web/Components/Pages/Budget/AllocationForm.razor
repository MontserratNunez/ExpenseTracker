@using ExpenseTracker.Core.Application.DTOs.Budget
@using ExpenseTracker.Core.Domain.Enums

<AppModal IsOpen="Visible && Editor is not null" Title="Editar plan" Width="OverlayWidth.Xl" OnClose="OnCancel">
    <ChildContent>
        @if (Editor is not null)
        {
            <ErrorAlert Message="@Error" />
            @if (Note is not null)
            {
                <InlineAlert Tone="InlineAlert.AlertTone.Warning">@Note</InlineAlert>
            }
            <p class="form-field__hint">
                Define cuánto quieres gastar por categoría. Un valor de 0 quita la categoría del plan.
                Con porcentaje se usa el ingreso de la fuente elegida o, si no eliges ninguna, el total de tus ingresos recurrentes
                (<MoneyText Amount="Editor.IncomeBases.RecurringTotal" Currency="BaseCurrency" />).
            </p>
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr><th>Categoría</th><th>Tipo</th><th>Valor</th><th>Fuente de ingreso</th><th class="num">Equivale a</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Rows)
                        {
                            var r = row;
                            <tr>
                                <td class="nowrap">
                                    <CategoryChip Name="@(r.IsActive ? r.CategoryName : $"{r.CategoryName} (inactiva)")" Color="@r.CategoryColor" />
                                </td>
                                <td style="min-width: 11rem;">
                                    <select class="field field--sm" aria-label="Tipo de @r.CategoryName" @bind="r.AllocationType">
                                        <option value="@AllocationType.FixedAmount">Monto fijo</option>
                                        <option value="@AllocationType.PercentageOfIncome">% de ingreso</option>
                                    </select>
                                </td>
                                <td style="min-width: 8rem;">
                                    <div class="field-group field-group--sm">
                                        <input type="number" step="any" min="0" class="field-group__control field-group__control--money"
                                               aria-label="Valor de @r.CategoryName" @bind="r.Value" @bind:event="oninput" />
                                        @if (r.AllocationType == AllocationType.PercentageOfIncome)
                                        {
                                            <span class="field-group__affix field-group__affix--end" aria-hidden="true">%</span>
                                        }
                                    </div>
                                </td>
                                <td style="min-width: 12rem;">
                                    @if (r.AllocationType == AllocationType.PercentageOfIncome)
                                    {
                                        <select class="field field--sm" aria-label="Fuente de @r.CategoryName" @bind="r.IncomeSourceId">
                                            <option value="">Total recurrente</option>
                                            @foreach (var source in Editor.IncomeBases.Sources)
                                            {
                                                <option value="@source.SourceId">@source.Name</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="num">
                                    @if (r.Value > 0)
                                    {
                                        <MoneyText Amount="Equivalent(r)" Currency="BaseCurrency" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="num">Total asignado</td>
                            <td class="num"><MoneyText Amount="TotalEquivalent" Currency="BaseCurrency" /></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            @if (TotalEquivalent > Editor.IncomeBases.RecurringTotal)
            {
                <InlineAlert Tone="InlineAlert.AlertTone.Warning" Class="mb-0">
                    El total asignado supera tus ingresos recurrentes
                    (<MoneyText Amount="Editor.IncomeBases.RecurringTotal" Currency="BaseCurrency" />).
                </InlineAlert>
            }
        }
    </ChildContent>
    <Footer>
        <AppButton Variant="AppButton.ButtonVariant.Ghost" OnClick="() => OnCancel.InvokeAsync()">Cancelar</AppButton>
        <AppButton OnClick="() => OnSave.InvokeAsync()">Guardar plan</AppButton>
    </Footer>
</AppModal>

@code {
    [Parameter]
    public bool Visible { get; set; }

    /// <summary>Income bases and categories. The rows below are edited in place and read by the parent on save.</summary>
    [Parameter]
    public AllocationEditorDto? Editor { get; set; }

    [Parameter, EditorRequired]
    public List<AllocationRowDto> Rows { get; set; } = new();

    [Parameter]
    public Currency BaseCurrency { get; set; } = Currency.DOP;

    [Parameter]
    public string? Error { get; set; }

    /// <summary>Warns which months the changes will reach.</summary>
    [Parameter]
    public string? Note { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private decimal TotalEquivalent => Rows.Where(r => r.Value > 0).Sum(Equivalent);

    private decimal Equivalent(AllocationRowDto row)
    {
        if (row.AllocationType == AllocationType.FixedAmount)
            return row.Value;

        var baseAmount = row.IncomeSourceId is { } id
            ? Editor!.IncomeBases.Sources.FirstOrDefault(s => s.SourceId == id)?.MonthlyAmount ?? 0m
            : Editor!.IncomeBases.RecurringTotal;

        return Math.Round(baseAmount * row.Value / 100m, 2, MidpointRounding.AwayFromZero);
    }
}
