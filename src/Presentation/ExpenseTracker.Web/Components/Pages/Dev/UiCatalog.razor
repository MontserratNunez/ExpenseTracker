@page "/dev/ui"
@using System.ComponentModel.DataAnnotations
@using ExpenseTracker.Core.Domain.Enums
@using ExpenseTracker.Web.Services
@inject IWebHostEnvironment Env
@inject ToastService Toasts

<PageTitle>Catálogo de componentes</PageTitle>

@if (!Env.IsDevelopment())
{
    <p>No disponible.</p>
}
else
{
    <h1>Catálogo de componentes</h1>
    <p class="text-muted">
        Muestra cada componente del sistema de diseño en todas sus variantes. Solo está disponible en desarrollo.
    </p>

    <section class="catalog-section" aria-labelledby="catalog-colors">
        <h2 id="catalog-colors">Paleta</h2>
        <p class="text-muted">El azul es el único acento. Verde, rojo y gris solo expresan el estado del dinero.</p>

        @foreach (var group in Palette)
        {
            <h3 class="catalog-group">@group.Title</h3>
            <div class="swatches">
                @foreach (var color in group.Colors)
                {
                    <div class="swatch">
                        <div class="swatch__chip" style="background: var(@color.Token);"></div>
                        <div class="swatch__name">@color.Token</div>
                        <div class="swatch__value">@color.Value</div>
                        <div class="swatch__use">@color.Use</div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="catalog-section" aria-labelledby="catalog-type">
        <h2 id="catalog-type">Tipografía</h2>
        <p class="text-muted">Fuente: Inter, alojada en <code>/fonts/inter</code>. Montos con cifras tabulares.</p>

        <table class="type-table">
            <thead>
                <tr><th>Token</th><th>Tamaño / peso</th><th>Uso</th><th>Muestra</th></tr>
            </thead>
            <tbody>
                @foreach (var step in TypeScale)
                {
                    <tr>
                        <td><code>@step.Token</code></td>
                        <td>@step.Size px / @step.Weight</td>
                        <td>@step.Use</td>
                        <td style="font-size: var(@step.Token); font-weight: @step.Weight; line-height: 1.3;">
                            @step.Sample
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h3 class="catalog-group">Cifras tabulares</h3>
        <div class="tabular-demo">
            <div><span>Supermercado</span><span>RD$ 4,885.40</span></div>
            <div><span>Recibo luz</span><span>RD$ 1,300.00</span></div>
            <div><span>Seguro</span><span>RD$ 20,000.00</span></div>
        </div>
    </section>

    <section class="catalog-section" aria-labelledby="catalog-space">
        <h2 id="catalog-space">Espaciado, radios y sombras</h2>

        <h3 class="catalog-group">Espacio (base 4 px)</h3>
        <div class="space-demo">
            @foreach (var space in Spaces)
            {
                <div class="space-demo__row">
                    <code>@space.Token</code>
                    <span class="space-demo__bar" style="width: var(@space.Token);"></span>
                    <span class="text-muted">@space.Px px</span>
                </div>
            }
        </div>

        <h3 class="catalog-group">Radios y sombras</h3>
        <div class="elevation-demo">
            <div style="border-radius: var(--radius-sm);">--radius-sm · 6 px</div>
            <div style="border-radius: var(--radius-md); box-shadow: var(--shadow-sm);">--radius-md · 10 px · --shadow-sm</div>
            <div style="border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);">--radius-lg · 14 px · --shadow-lg</div>
        </div>
    </section>

    <section class="catalog-section" aria-labelledby="catalog-icons">
        <h2 id="catalog-icons">Íconos</h2>
        <p class="text-muted">
            Bootstrap Icons 1.13.2, alojados en <code>/lib/bootstrap-icons</code>. Se usan con
            <code>&lt;AppIcon Name="@@Icons.Delete" /&gt;</code>; la interfaz no usa emojis.
        </p>

        <h3 class="catalog-group">Nombrados (@NamedIcons.Count)</h3>
        <div class="icon-grid">
            @foreach (var icon in NamedIcons)
            {
                <div class="icon-cell">
                    <AppIcon Name="@icon.Value" Size="22" />
                    <span class="icon-cell__const">@icon.Constant</span>
                    <span class="icon-cell__name">@icon.Value</span>
                </div>
            }
        </div>

        <h3 class="catalog-group">Selector de categorías y metas (@Icons.Picker.Length)</h3>
        <div class="icon-grid">
            @foreach (var name in Icons.Picker)
            {
                <div class="icon-cell">
                    <AppIcon Name="@name" Size="22" />
                    <span class="icon-cell__name">@name</span>
                </div>
            }
        </div>

        <h3 class="catalog-group">Tamaños y color</h3>
        <div class="icon-sizes">
            <AppIcon Name="@Icons.Budget" Size="14" />
            <AppIcon Name="@Icons.Budget" Size="18" />
            <AppIcon Name="@Icons.Budget" Size="24" />
            <AppIcon Name="@Icons.Budget" Size="32" />
            <span class="icon-sizes__blue"><AppIcon Name="@Icons.Budget" Size="24" /> hereda el color del texto</span>
            <span><AppIcon Name="@Icons.Delete" Size="24" Label="Eliminar" /> con etiqueta accesible</span>
        </div>
    </section>

    <section class="catalog-section" aria-labelledby="catalog-buttons">
        <h2 id="catalog-buttons">AppButton</h2>
        <p class="text-muted">Cuatro variantes, dos tamaños, ícono opcional, estado de carga y versión solo ícono (con <code>AriaLabel</code>).</p>

        @foreach (var variant in Enum.GetValues<AppButton.ButtonVariant>())
        {
            <h3 class="catalog-group">@variant</h3>
            <div class="demo-row">
                <AppButton Variant="variant">Guardar</AppButton>
                <AppButton Variant="variant" Icon="@Icons.Add">Con ícono</AppButton>
                <AppButton Variant="variant" Size="AppButton.ButtonSize.Sm">Pequeño</AppButton>
                <AppButton Variant="variant" Disabled="true">Deshabilitado</AppButton>
                <AppButton Variant="variant" Loading="saving" OnClick="SimulateSaveAsync">@(saving ? "Guardando" : "Probar carga")</AppButton>
                <AppButton Variant="variant" Icon="@Icons.Edit" AriaLabel="Editar" />
                <AppButton Variant="variant" Size="AppButton.ButtonSize.Sm" Icon="@Icons.Delete" AriaLabel="Eliminar" />
            </div>
        }
        <p class="text-muted catalog-note">Clics de botones de prueba: @clicks</p>
        <div class="demo-row">
            <AppButton Variant="AppButton.ButtonVariant.Secondary" OnClick="CountClick">Contar un clic</AppButton>
        </div>
    </section>

    <section class="catalog-section" aria-labelledby="catalog-badges">
        <h2 id="catalog-badges">Badge</h2>
        <p class="text-muted">El color nunca va solo: los estados llevan ícono y texto.</p>

        <h3 class="catalog-group">Tonos</h3>
        <div class="demo-row">
            @foreach (var tone in Enum.GetValues<Badge.BadgeTone>())
            {
                <Badge Tone="tone">@tone</Badge>
            }
        </div>

        <h3 class="catalog-group">Usos</h3>
        <div class="demo-row">
            <Badge Tone="Badge.BadgeTone.Blue" Icon="@Icons.Recurring">Mensual</Badge>
            <Badge Tone="Badge.BadgeTone.Green" Icon="@Icons.Paid">Pagado</Badge>
            <Badge Tone="Badge.BadgeTone.Gray" Icon="@Icons.Pending">Pendiente</Badge>
            <Badge Tone="Badge.BadgeTone.Green" Icon="@Icons.OnTrack">En plan</Badge>
            <Badge Tone="Badge.BadgeTone.Amber" Icon="@Icons.AtRisk">En riesgo</Badge>
            <Badge Tone="Badge.BadgeTone.Red" Icon="@Icons.Exceeded">Excedido</Badge>
            <Badge Tone="Badge.BadgeTone.Green" Icon="@Icons.GoalOnTrack">En camino</Badge>
            <Badge Tone="Badge.BadgeTone.Amber" Icon="@Icons.GoalBehind">Atrasada</Badge>
            <Badge Tone="Badge.BadgeTone.Blue" Icon="@Icons.GoalDone">Lograda</Badge>
        </div>
    </section>

    <section class="catalog-section" aria-labelledby="catalog-chips">
        <h2 id="catalog-chips">CategoryChip</h2>

        <h3 class="catalog-group">Con nombre</h3>
        <div class="demo-row">
            <CategoryChip Name="Comida" Color="#E67E22" Icon="basket" />
            <CategoryChip Name="Servicios" Color="#3498DB" Icon="lightning-charge" />
            <CategoryChip Name="Ahorro" Color="#2E9E5B" Icon="piggy-bank" />
            <CategoryChip Name="Entretenimiento" Color="#F1C40F" Icon="film" />
            <CategoryChip Name="Sin ícono" Color="#9B59B6" />
            <CategoryChip Name="Color inválido" Color="rojo; x:y" Icon="tag" />
        </div>

        <h3 class="catalog-group">Solo ícono (el nombre queda como tooltip y para lectores de pantalla)</h3>
        <div class="demo-row">
            <CategoryChip Name="Comida" Color="#E67E22" Icon="basket" ShowName="false" />
            <CategoryChip Name="Servicios" Color="#3498DB" Icon="lightning-charge" ShowName="false" />
            <CategoryChip Name="Ahorro" Color="#2E9E5B" Icon="piggy-bank" ShowName="false" />
            <CategoryChip Name="Entretenimiento" Color="#F1C40F" Icon="film" ShowName="false" />
            <CategoryChip Name="Sin ícono" Color="#9B59B6" ShowName="false" />
        </div>
    </section>

    <section class="catalog-section" aria-labelledby="catalog-cards">
        <h2 id="catalog-cards">AppCard</h2>
        <div class="grid-auto">
            <AppCard AriaLabel="Tarjeta simple">
                Tarjeta simple, solo contenido.
            </AppCard>
            <AppCard>
                <Header>Con encabezado</Header>
                <ChildContent>Contenido con título arriba y un divisor fino.</ChildContent>
            </AppCard>
            <AppCard>
                <Header>Con encabezado y pie</Header>
                <ChildContent>Los tres espacios (encabezado, cuerpo y pie) son opcionales.</ChildContent>
                <Footer><AppButton Variant="AppButton.ButtonVariant.Ghost" Size="AppButton.ButtonSize.Sm">Ver detalle</AppButton></Footer>
            </AppCard>
        </div>
    </section>

    <section class="catalog-section" aria-labelledby="catalog-stats">
        <h2 id="catalog-stats">StatCard</h2>
        <p class="text-muted">El punto de color indica el significado financiero; la tendencia usa ícono y texto.</p>
        <div class="grid-auto">
            <StatCard Label="Disponible" Amount="21300m" Tone="StatCard.StatTone.Available" />
            <StatCard Label="Gastado" Amount="28067m" Tone="StatCard.StatTone.Spent" Trend="12m" />
            <StatCard Label="Comprometido" Amount="1905m" Tone="StatCard.StatTone.Committed" Trend="-4.5m" />
            <StatCard Label="Ingresos del mes" Amount="65000m" />
            <StatCard Label="Gasto en dólares" Amount="120.5m" Currency="Currency.USD" />
            <StatCard Label="Con nota" Amount="5000m" Tone="StatCard.StatTone.Available">
                <div class="text-muted">Asignado 10 % de tus ingresos</div>
            </StatCard>
        </div>

        <h3 class="catalog-group">Tamaño grande</h3>
        <div class="grid-auto">
            <StatCard Label="Disponible" Amount="21300m" Tone="StatCard.StatTone.Available" Large="true" />
        </div>
    </section>

    <section class="catalog-section" aria-labelledby="catalog-header">
        <h2 id="catalog-header">PageHeader</h2>
        <div class="demo-frame">
            <PageHeader Title="Gastos" Subtitle="Noviembre 2026">
                <Actions>
                    <AppButton Variant="AppButton.ButtonVariant.Ghost" Icon="@Icons.Filter">Filtros</AppButton>
                    <AppButton Icon="@Icons.Add">Nuevo gasto</AppButton>
                </Actions>
            </PageHeader>
        </div>
        <div class="demo-frame">
            <PageHeader Title="Sin acciones" />
        </div>
    </section>

    <section class="catalog-section" aria-labelledby="catalog-forms">
        <h2 id="catalog-forms">Formularios</h2>
        <p class="text-muted">
            Cada campo trae su etiqueta, ayuda y mensaje de error en español debajo del campo.
            Prueba enviar vacío, escribir <code>5000,5</code> en el monto (se rechaza), o <code>5000</code> (se formatea al salir).
        </p>

        <div class="demo-frame">
            <EditForm EditContext="catalogContext" OnValidSubmit="OnCatalogValid" OnInvalidSubmit="OnCatalogInvalid">
                <DataAnnotationsValidator />

                <AppInput Label="Nombre" Hint="Como aparece en la lista" Placeholder="Supermercado" @bind-Value="catalogForm.Name" />

                <MoneyInput Label="Monto" Hint="Acepta 5000, 5,000, 5000.5 y 5,000.50"
                            @bind-Amount="catalogForm.Amount" @bind-Currency="catalogForm.Currency" />

                <div class="form-grid">
                    <AppNumber TValue="decimal" Label="Tasa anual" Suffix="%" Min="0" Max="100" @bind-Value="catalogForm.Rate" />
                    <AppNumber TValue="int" Label="Día de pago (1-28)" Step="1" InputMode="numeric" @bind-Value="catalogForm.Day" />
                </div>

                <div class="form-grid">
                    <AppSelect TValue="Frequency" Label="Frecuencia" @bind-Value="catalogForm.Frequency">
                        @foreach (var frequency in Enum.GetValues<Frequency>())
                        {
                            <option value="@frequency">@UiLabels.FrequencyName(frequency)</option>
                        }
                    </AppSelect>
                    <AppDate TValue="DateOnly" Label="Fecha" @bind-Value="catalogForm.Date" />
                </div>

                <AppTextarea Label="Notas" Rows="2" @bind-Value="catalogForm.Notes" />
                <AppToggle Label="Es recurrente" Hint="Se repite según la frecuencia" @bind-Value="catalogForm.Recurring" />

                <div class="demo-row">
                    <AppButton Type="submit">Guardar</AppButton>
                    <AppButton Variant="AppButton.ButtonVariant.Secondary" OnClick="ValidateNow">Validar ahora</AppButton>
                    <AppButton Variant="AppButton.ButtonVariant.Ghost" OnClick="ResetCatalogForm">Limpiar</AppButton>
                </div>
            </EditForm>

            @if (catalogResult is not null)
            {
                <p class="catalog-note" role="status">@catalogResult</p>
            }
        </div>

        <h3 class="catalog-group">Deshabilitados y moneda fija</h3>
        <div class="demo-frame">
            <EditForm Model="disabledDemo" FormName="catalog-disabled">
                <AppInput Label="Nombre" Disabled="true" @bind-Value="disabledDemo.Name" />
                <MoneyInput Label="Monto con moneda fija" ShowCurrencySelector="false" Currency="Currency.USD" Amount="1250.5m" />
                <MoneyInput Label="Monto deshabilitado" Amount="300m" Disabled="true" />
                <AppToggle Label="Interruptor deshabilitado" Disabled="true" @bind-Value="disabledDemo.On" />
            </EditForm>
        </div>
    </section>

    <section class="catalog-section" aria-labelledby="catalog-overlays">
        <h2 id="catalog-overlays">Modales, paneles, menús y popover</h2>
        <p class="text-muted">
            Con una superposición abierta: el foco queda dentro (Tab y Mayús+Tab giran), <kbd>Esc</kbd> la cierra,
            un clic en la zona oscura la cierra, la página de atrás no se desplaza y el foco vuelve al botón que la abrió.
        </p>

        <h3 class="catalog-group">Modal, panel y confirmación</h3>
        <div class="demo-row">
            <AppButton OnClick="() => modalOpen = true">Abrir modal</AppButton>
            <AppButton Variant="AppButton.ButtonVariant.Secondary" OnClick="() => longModalOpen = true">Modal con contenido largo</AppButton>
            <AppButton Variant="AppButton.ButtonVariant.Secondary" OnClick="() => nestedOpen = true">Modal con otro encima</AppButton>
            <AppButton Variant="AppButton.ButtonVariant.Secondary" OnClick="() => panelOpen = true">Panel lateral</AppButton>
            <AppButton Variant="AppButton.ButtonVariant.Danger" Icon="@Icons.Delete" OnClick="() => confirmOpen = true">Eliminar…</AppButton>
        </div>

        <h3 class="catalog-group">Menú desplegable</h3>
        <p class="text-muted catalog-note">
            En el botón: <kbd>Enter</kbd>, <kbd>Espacio</kbd> o <kbd>↓</kbd> abren; <kbd>↑</kbd> y <kbd>↓</kbd> se mueven;
            <kbd>Inicio</kbd> y <kbd>Fin</kbd> saltan; <kbd>Esc</kbd> cierra y vuelve al botón; <kbd>Tab</kbd> cierra.
        </p>
        <div class="demo-frame">
            <div class="d-flex justify-content-between align-items-center">
                <span>Suscripción Netflix</span>
                <DropdownMenu AriaLabel="Acciones de Suscripción Netflix" Items="menuItems" />
            </div>
        </div>
        <p class="catalog-note" role="status">Última acción: <strong>@(lastAction ?? "ninguna")</strong></p>

        <h3 class="catalog-group">Popover</h3>
        <div class="demo-row">
            <div class="popover-anchor">
                <AppButton Variant="AppButton.ButtonVariant.Secondary" Icon="@Icons.Calendar" OnClick="() => popoverOpen = !popoverOpen"
                           aria-haspopup="dialog" aria-expanded="@(popoverOpen ? "true" : "false")">Elegir mes</AppButton>
                <Popover IsOpen="popoverOpen" OnClose="() => popoverOpen = false" AriaLabel="Elegir mes">
                    <p class="mb-2"><strong>Contenido del popover</strong></p>
                    <div class="demo-row">
                        <AppButton Size="AppButton.ButtonSize.Sm" OnClick="PickFromPopover">Noviembre 2026</AppButton>
                        <AppButton Size="AppButton.ButtonSize.Sm" Variant="AppButton.ButtonVariant.Ghost" OnClick="() => popoverOpen = false">Cerrar</AppButton>
                    </div>
                </Popover>
            </div>
        </div>
    </section>

    <section class="catalog-section" aria-labelledby="catalog-feedback">
        <h2 id="catalog-feedback">Estados y avisos</h2>

        <h3 class="h6">Toasts</h3>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <AppButton Variant="AppButton.ButtonVariant.Secondary" OnClick="() => ShowToast(ToastKind.Success)">Éxito</AppButton>
            <AppButton Variant="AppButton.ButtonVariant.Secondary" OnClick="() => ShowToast(ToastKind.Error)">Error</AppButton>
            <AppButton Variant="AppButton.ButtonVariant.Secondary" OnClick="() => ShowToast(ToastKind.Info)">Información</AppButton>
            <AppButton Variant="AppButton.ButtonVariant.Secondary" OnClick="ShowUndoToast">Con Deshacer</AppButton>
        </div>
        <p class="text-muted" data-testid="toast-result">@toastResult</p>

        <h3 class="h6">InlineAlert</h3>
        <InlineAlert Tone="InlineAlert.AlertTone.Info">Información: tu plan se recalcula al cambiar un ingreso.</InlineAlert>
        <InlineAlert Tone="InlineAlert.AlertTone.Success">Todo al día: no tienes pagos pendientes.</InlineAlert>
        <InlineAlert Tone="InlineAlert.AlertTone.Warning">Asignaste más de lo que ingresas este mes.</InlineAlert>
        <InlineAlert Tone="InlineAlert.AlertTone.Danger" OnDismiss="() => { }">Déficit de RD$ 1,200.00 este mes.</InlineAlert>

        <h3 class="h6">ProgressBar</h3>
        <div class="d-grid gap-3 mb-3" style="max-width: 420px;">
            <ProgressBar Percent="45" Label="45% de la meta" />
            <ProgressBar Percent="45" ColorVar="--color-warning" Height="6" Label="Compacta, 45%" />
            <ProgressBar Segments="progressSegments" Marker="80" MarkerLabel="Estimado a fin de mes" Label="Gastado, pendiente y estimado" />
        </div>

        <h3 class="h6">Skeleton</h3>
        <div class="d-flex gap-3 align-items-center mb-3">
            <Skeleton Circle="true" Width="40px" Height="40px" Class="flex-none" />
            <Skeleton Lines="3" Height="1rem" Class="flex-grow-1" />
        </div>

        <h3 class="h6">EmptyState</h3>
        <EmptyState Icon="@Icons.EmptyGoals" Title="Aún no tienes metas" Description="Crea una, por ejemplo Ahorro de 200,000 anualmente, y sigue tu avance mes a mes.">
            <Action><AppButton Icon="@Icons.Add">Nueva meta</AppButton></Action>
        </EmptyState>
    </section>

    <AppModal IsOpen="modalOpen" Title="Un modal" OnClose="() => modalOpen = false">
        <ChildContent>
            <p>Este es el modal normal: 520 px de ancho como máximo.</p>
            <EditForm Model="overlayDemo" FormName="catalog-modal">
                <AppInput Label="Un campo" Placeholder="El foco empieza aquí" @bind-Value="overlayDemo.Text" />
            </EditForm>
        </ChildContent>
        <Footer>
            <AppButton Variant="AppButton.ButtonVariant.Ghost" OnClick="() => modalOpen = false">Cancelar</AppButton>
            <AppButton OnClick="() => modalOpen = false">Aceptar</AppButton>
        </Footer>
    </AppModal>

    <AppModal IsOpen="longModalOpen" Title="Contenido largo" OnClose="() => longModalOpen = false">
        <ChildContent>
            @for (var i = 1; i <= 30; i++)
            {
                <p>Párrafo @i de relleno: el cuerpo se desplaza dentro del modal mientras el encabezado y el pie quedan fijos.</p>
            }
        </ChildContent>
        <Footer>
            <AppButton OnClick="() => longModalOpen = false">Entendido</AppButton>
        </Footer>
    </AppModal>

    <AppModal IsOpen="nestedOpen" Title="Primer modal" OnClose="() => nestedOpen = false">
        <ChildContent>
            <p>Abre otra superposición encima. Al cerrarla, el foco vuelve a este modal.</p>
            <AppButton Variant="AppButton.ButtonVariant.Danger" OnClick="() => nestedConfirmOpen = true">Abrir confirmación</AppButton>
        </ChildContent>
        <Footer>
            <AppButton Variant="AppButton.ButtonVariant.Ghost" OnClick="() => nestedOpen = false">Cerrar</AppButton>
        </Footer>
    </AppModal>

    <ConfirmDialog @bind-Visible="nestedConfirmOpen" Title="Confirmación anidada" Message="Se muestra encima del primer modal." ConfirmText="Confirmar" />

    <SidePanel IsOpen="panelOpen" Title="Panel lateral" OnClose="() => panelOpen = false">
        <ChildContent>
            <p>Entra desde la derecha y deja la página visible detrás.</p>
            <EditForm Model="overlayDemo" FormName="catalog-panel">
                <AppInput Label="Nombre" @bind-Value="overlayDemo.Text" />
            </EditForm>
        </ChildContent>
        <Footer>
            <AppButton Variant="AppButton.ButtonVariant.Ghost" OnClick="() => panelOpen = false">Cancelar</AppButton>
            <AppButton OnClick="() => panelOpen = false">Guardar</AppButton>
        </Footer>
    </SidePanel>

    <ConfirmDialog @bind-Visible="confirmOpen" Title="Eliminar elemento" Message="¿Eliminar este elemento? Esta acción no se puede deshacer."
                   ConfirmText="Eliminar" OnConfirm="ConfirmDemoDelete" />
}

@code {
    private bool modalOpen;
    private bool longModalOpen;
    private bool nestedOpen;
    private bool nestedConfirmOpen;
    private bool panelOpen;
    private bool confirmOpen;
    private bool popoverOpen;
    private string? lastAction;
    private string? toastResult;

    private readonly IReadOnlyList<ProgressSegment> progressSegments = new[]
    {
        new ProgressSegment { Value = 45m, ColorVar = "--color-spent" },
        new ProgressSegment { Value = 25m, ColorVar = "--color-committed", Striped = true }
    };

    private void ShowToast(ToastKind kind)
    {
        switch (kind)
        {
            case ToastKind.Success: Toasts.ShowSuccess("Gasto guardado."); break;
            case ToastKind.Error: Toasts.ShowError("No se pudo guardar."); break;
            default: Toasts.ShowInfo("Se actualizó la tasa."); break;
        }
    }

    private void ShowUndoToast()
    {
        toastResult = null;
        Toasts.Show(ToastKind.Success, "Gasto eliminado.", "Deshacer", () =>
        {
            toastResult = "Deshacer ejecutado";
            return InvokeAsync(StateHasChanged);
        });
    }
    private sealed class OverlayDemoModel
    {
        public string? Text { get; set; }
    }

    private readonly OverlayDemoModel overlayDemo = new();
    private IReadOnlyList<DropdownMenuItem> menuItems = Array.Empty<DropdownMenuItem>();

    private void PickFromPopover()
    {
        popoverOpen = false;
        lastAction = "Noviembre 2026 elegido";
    }

    private void ConfirmDemoDelete() => lastAction = "Eliminado (confirmado)";

    // An EventCallback created here re-renders this page after it runs, so the page reacts to the menu.
    private EventCallback Callback(Func<Task> work) => EventCallback.Factory.Create(this, work);

    private Task SetActionAsync(string action)
    {
        lastAction = action;
        return Task.CompletedTask;
    }

    private sealed class CatalogFormModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(100, ErrorMessage = "El nombre no puede superar {1} caracteres.")]
        [Display(Name = "Nombre")]
        public string? Name { get; set; }

        [Range(typeof(decimal), "0.01", "999999999999", ErrorMessage = "El monto debe ser mayor que cero.")]
        [Display(Name = "Monto")]
        public decimal Amount { get; set; }

        public Currency Currency { get; set; } = Currency.DOP;

        [Range(typeof(decimal), "0", "100", ErrorMessage = "La tasa anual debe estar entre 0 y 100.")]
        [Display(Name = "Tasa anual")]
        public decimal Rate { get; set; }

        [Range(1, 28, ErrorMessage = "El día de pago debe estar entre 1 y 28.")]
        [Display(Name = "Día de pago")]
        public int Day { get; set; } = 1;

        [Display(Name = "Frecuencia")]
        public Frequency Frequency { get; set; } = Frequency.Monthly;

        [Display(Name = "Fecha")]
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);

        [Display(Name = "Notas")]
        public string? Notes { get; set; }

        public bool Recurring { get; set; }
    }

    private sealed class DisabledDemoModel
    {
        public string? Name { get; set; } = "No editable";
        public bool On { get; set; } = true;
    }

    // Form fields need an EditForm around them, even when they are only shown.
    private readonly DisabledDemoModel disabledDemo = new();

    private CatalogFormModel catalogForm = new();
    private EditContext catalogContext = default!;
    private string? catalogResult;

    protected override void OnInitialized()
    {
        catalogContext = new EditContext(catalogForm);
        menuItems = new[]
        {
            new DropdownMenuItem("Editar", Icons.Edit, Callback(() => SetActionAsync("Editar"))),
            new DropdownMenuItem("Duplicar", Icons.Duplicate, Callback(() => SetActionAsync("Duplicar"))),
            new DropdownMenuItem("No disponible", Icons.Close, disabled: true),
            new DropdownMenuItem("Eliminar", Icons.Delete, Callback(() => { confirmOpen = true; return Task.CompletedTask; }), danger: true)
        };
    }

    private void OnCatalogValid() => catalogResult = $"Formulario válido: {catalogForm.Name}, {catalogForm.Currency} {catalogForm.Amount:N2}.";

    private void OnCatalogInvalid() => catalogResult = "El formulario tiene errores; revisa los mensajes bajo cada campo.";

    private void ValidateNow() => catalogContext.Validate();

    private void ResetCatalogForm()
    {
        catalogForm = new CatalogFormModel();
        catalogContext = new EditContext(catalogForm);
        catalogResult = null;
    }

    private bool saving;
    private int clicks;

    private async Task SimulateSaveAsync()
    {
        saving = true;
        await Task.Delay(1500);
        saving = false;
    }

    private void CountClick() => clicks++;

    private sealed class Swatch
    {
        public Swatch(string token, string value, string use)
        {
            Token = token;
            Value = value;
            Use = use;
        }

        public string Token { get; }
        public string Value { get; }
        public string Use { get; }
    }

    private sealed class SwatchGroup
    {
        public SwatchGroup(string title, params Swatch[] colors)
        {
            Title = title;
            Colors = colors;
        }

        public string Title { get; }
        public Swatch[] Colors { get; }
    }

    private sealed class TypeStep
    {
        public TypeStep(string token, int size, int weight, string use, string sample)
        {
            Token = token;
            Size = size;
            Weight = weight;
            Use = use;
            Sample = sample;
        }

        public string Token { get; }
        public int Size { get; }
        public int Weight { get; }
        public string Use { get; }
        public string Sample { get; }
    }

    private sealed class NamedIcon
    {
        public NamedIcon(string constant, string value)
        {
            Constant = constant;
            Value = value;
        }

        public string Constant { get; }
        public string Value { get; }
    }

    private sealed class SpaceStep
    {
        public SpaceStep(string token, int px)
        {
            Token = token;
            Px = px;
        }

        public string Token { get; }
        public int Px { get; }
    }

