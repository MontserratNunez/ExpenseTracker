@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics

<PageTitle>Error · Expense Tracker</PageTitle>

<h1>Algo salió mal</h1>
<InlineAlert Tone="InlineAlert.AlertTone.Danger">Ocurrió un error al procesar tu solicitud. Inténtalo de nuevo; si sigue pasando, avísanos con el identificador de abajo.</InlineAlert>

@if (ShowRequestId)
{
    <p><strong>Identificador de la solicitud:</strong> <code>@RequestId</code></p>
}

<p class="account-links"><a href="/">Ir al inicio</a></p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
