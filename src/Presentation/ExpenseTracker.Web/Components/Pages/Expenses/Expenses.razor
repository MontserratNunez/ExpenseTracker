@page "/gastos"
@page "/gastos/{year:int}/{month:int}"
@using ExpenseTracker.Core.Application.DTOs.Expenses
@using ExpenseTracker.Core.Application.DTOs.Settings
@using ExpenseTracker.Core.Application.Helpers
@using ExpenseTracker.Core.Application.Interfaces
@using ExpenseTracker.Core.Application.Services
@using ExpenseTracker.Core.Domain.Enums
@using ExpenseTracker.Web.Services
@inject ExpenseService ExpenseService
@inject CategoryService CategoryService
@inject CurrencyService CurrencyService
@inject IDateProvider DateProvider
@inject NavigationManager Navigation
@inject ToastService Toasts
@implements IDisposable

<PageTitle>Gastos</PageTitle>

<PageHeader Title="Gastos">
    <Actions><AppButton OnClick="StartCreate" Icon="@Icons.Add" Disabled="@loading">Nuevo gasto</AppButton></Actions>
</PageHeader>

<div class="exp-toolbar">
    <MonthNavigator Year="CurrentYear" Month="CurrentMonth" OnChange="GoToMonth" LoadYearTotals="ExpenseService.GetYearTotalsAsync" />
    @if (data is not null)
    {
        <dl class="exp-totals">
            <div>
                <dt><span class="exp-dot exp-dot--spent" aria-hidden="true"></span>Gastado</dt>
                <dd><MoneyText Amount="data.TotalSpent" Currency="baseCurrency" /></dd>
            </div>
            <div>
                <dt><span class="exp-dot exp-dot--pending" aria-hidden="true"></span>Pendiente</dt>
                <dd><MoneyText Amount="data.TotalPending" Currency="baseCurrency" /></dd>
            </div>
        </dl>
    }
</div>

<ErrorAlert @bind-Message="error" />
<SuccessToast Message="@message" />

@if (loading)
{
    <Skeleton Lines="6" Height="2.75rem" />
}
else if (data is not null)
{
    <div class="exp-filters">
        <DropdownMenu AriaLabel="Filtrar por categoría" Items="CategoryFilterItems()" Align="DropdownMenu.MenuAlign.Start"
                      TriggerClass="btn-app btn-app--ghost btn-app--sm">
            <TriggerContent><AppIcon Name="@Icons.Filter" Size="14" /> <span>@CategoryFilterLabel</span></TriggerContent>
        </DropdownMenu>
        <DropdownMenu AriaLabel="Filtrar por tipo" Items="TypeFilterItems()" Align="DropdownMenu.MenuAlign.Start"
                      TriggerClass="btn-app btn-app--ghost btn-app--sm">
            <TriggerContent><AppIcon Name="@Icons.Filter" Size="14" /> <span>@TypeFilterLabel</span></TriggerContent>
        </DropdownMenu>
        @if (categoryFilter != 0 || typeFilter != TypeFilter.All)
        {
            <AppButton Variant="AppButton.ButtonVariant.Ghost" Size="AppButton.ButtonSize.Sm" Icon="@Icons.Close" OnClick="ClearFilters">Quitar filtros</AppButton>
        }
    </div>

    <div class="quick-add">
        <AppIcon Name="@Icons.Add" Size="16" Class="quick-add__icon" />
        <input type="text" class="quick-add__input" autocomplete="off" maxlength="120"
               aria-label="Agregar gasto rápido"
               placeholder="Agregar gasto… ej. Supermercado 700"
               @bind="quickText" @bind:event="oninput" @onkeydown="OnQuickKeyDownAsync" />
    </div>

    @if (data.Items.Count == 0)
    {
        <EmptyState Icon="@Icons.Empty" Title="@($"No hay gastos en {UiLabels.MonthName(CurrentMonth).ToLower()}")"
                    Description="Registra el primero para ver cómo avanza tu mes.">
            <Action><AppButton OnClick="StartCreate" Icon="@Icons.Add">Nuevo gasto</AppButton></Action>
        </EmptyState>
    }
    else if (VisibleItems.Count == 0)
    {
        <p class="text-muted">Ningún gasto coincide con los filtros.</p>
    }
    else
    {
        <DayGroupedList TItem="LedgerItem" Items="VisibleItems" DateOf="i => i.Date" AmountOf="i => i.AmountInBase"
                        Currency="baseCurrency" RowClass="PendingClass">
            <ItemTemplate Context="i">
                @if (i.IsReadOnly)
                {
                    <div class="exp-row__main">
                        @RowContent(i, i.Status == LedgerStatus.Pending)
                    </div>
                }
                else
                {
                    <button type="button" class="exp-row__main" @onclick="() => StartEdit(i)">
                        @RowContent(i, i.Status == LedgerStatus.Pending)
                    </button>
                    <div class="exp-row__menu">
                        <DropdownMenu AriaLabel="Más acciones" Items="RowMenu(i)" />
                    </div>
                }
            </ItemTemplate>
        </DayGroupedList>
    }
}

<ExpenseForm Visible="showForm" Title="@(editingId is null ? "Nuevo gasto" : "Editar gasto")" IsEditing="editingId is not null"
             Model="input" Categories="categories" Error="@formError"
             OnSave="SaveAsync" OnCancel="CloseForm" OnDelete="AskDelete" />

<ConfirmDialog @bind-Visible="confirmDelete" Title="Eliminar gasto"
               Message="¿Eliminar este gasto? Esta acción no se puede deshacer."
               ConfirmText="Eliminar" OnConfirm="DeleteAsync" />

<AppModal IsOpen="showRecurringDelete" Title="Gasto recurrente" OnClose="() => { showRecurringDelete = false; return Task.CompletedTask; }">
    <ChildContent>
        <p><strong>Finalizar</strong> detiene el gasto desde hoy y conserva el historial de los meses anteriores.</p>
        <p><strong>Eliminar por completo</strong> borra el gasto y todas sus ocurrencias pasadas y futuras.</p>
    </ChildContent>
    <Footer>
        <AppButton Variant="AppButton.ButtonVariant.Ghost" OnClick="() => showRecurringDelete = false" data-autofocus="true">Cancelar</AppButton>
        <AppButton Variant="AppButton.ButtonVariant.Secondary" OnClick="EndRecurringAsync">Finalizar</AppButton>
        <AppButton Variant="AppButton.ButtonVariant.Danger" OnClick="DeleteRecurringAsync">Eliminar por completo</AppButton>
    </Footer>
</AppModal>

@code {
    private enum TypeFilter { All, OneTime, Recurring }

    [Parameter]
    public int? Year { get; set; }

    [Parameter]
    public int? Month { get; set; }

    /// <summary>"?nuevo=1" opens the new-expense panel on arrival (used by the central button of the phone navigation).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "nuevo")]
    public string? OpenNew { get; set; }

    private int CurrentYear => Year ?? DateProvider.Today.Year;
    private int CurrentMonth => Month ?? DateProvider.Today.Month;

    private bool loading = true;
    private string? error;
    private string? message;
    private string? formError;

    private Currency baseCurrency = Currency.DOP;
    private List<CategoryDto> categories = new();
    private MonthExpensesDto? data;
    private int loadedYear;
    private int loadedMonth;

    private int categoryFilter;
    private TypeFilter typeFilter = TypeFilter.All;
    private string quickText = string.Empty;

    private bool showForm;
    private int? editingId;
    private bool editingIsRecurring;
    private ExpenseInput input = new();
    private bool confirmDelete;
    private bool showRecurringDelete;

    private static string? PendingClass(LedgerItem item) => item.Status == LedgerStatus.Pending ? "exp-row--pending" : null;

    // The rows shown after the category and type filters; the list component groups them by day.
    private List<LedgerItem> VisibleItems => data is null
        ? new List<LedgerItem>()
        : data.Items
            .Where(i => categoryFilter == 0 || i.CategoryId == categoryFilter)
            .Where(i => typeFilter switch
            {
                TypeFilter.OneTime => i.Source == LedgerSource.OneTimeExpense,
                TypeFilter.Recurring => i.Source == LedgerSource.RecurringExpense,
                _ => true
            })
            .ToList();

    protected override async Task OnParametersSetAsync()
    {
        var today = DateProvider.Today;
        if (Year is null || Month is null || Month < 1 || Month > 12 || Year < 1 || Year > 9999)
        {
            Navigation.NavigateTo($"/gastos/{today.Year}/{today.Month}" + (OpenNew == "1" ? "?nuevo=1" : string.Empty), replace: true);
            return;
        }

        if (loadedYear != Year || loadedMonth != Month)
        {
            loadedYear = Year.Value;
            loadedMonth = Month.Value;
            message = null;
            loading = true;
            await RunAsync(LoadAsync);
            loading = false;
        }

        if (OpenNew == "1" && !loading)
        {
            OpenNew = null;
            StartCreate();
            Navigation.NavigateTo($"/gastos/{CurrentYear}/{CurrentMonth}", replace: true);   // drop the query so a reload does not reopen it
        }
    }

    private async Task LoadAsync()
    {
        baseCurrency = await CurrencyService.GetBaseCurrencyAsync();
        categories = await CategoryService.ListAsync();
        data = await ExpenseService.GetMonthAsync(CurrentYear, CurrentMonth);
    }

    private void GoToMonth((int Year, int Month) value)
        => Navigation.NavigateTo($"/gastos/{value.Year}/{value.Month}");

    // ---------- Filters ----------

    private string CategoryFilterLabel
        => categoryFilter == 0 ? "Categoría" : categories.FirstOrDefault(c => c.Id == categoryFilter)?.Name ?? "Categoría";

    private string TypeFilterLabel => typeFilter switch
    {
        TypeFilter.OneTime => "Únicos",
        TypeFilter.Recurring => "Recurrentes",
        _ => "Tipo"
    };

    private IReadOnlyList<DropdownMenuItem> CategoryFilterItems()
    {
        var items = new List<DropdownMenuItem> { FilterItem("Todas las categorías", categoryFilter == 0, () => categoryFilter = 0) };
        items.AddRange(categories.Select(c =>
        {
            var id = c.Id;
            return FilterItem(c.Name, categoryFilter == id, () => categoryFilter = id);
        }));
        return items;
    }

    private IReadOnlyList<DropdownMenuItem> TypeFilterItems() => new[]
    {
        FilterItem("Todos", typeFilter == TypeFilter.All, () => typeFilter = TypeFilter.All),
        FilterItem("Únicos", typeFilter == TypeFilter.OneTime, () => typeFilter = TypeFilter.OneTime),
        FilterItem("Recurrentes", typeFilter == TypeFilter.Recurring, () => typeFilter = TypeFilter.Recurring)
    };

    // The chosen option carries a check mark: the state never depends on color alone.
    private DropdownMenuItem FilterItem(string label, bool selected, Action choose)
        => new(label, selected ? Icons.Paid : null, EventCallback.Factory.Create(this, choose));

    private void ClearFilters()
    {
        categoryFilter = 0;
        typeFilter = TypeFilter.All;
    }

    // ---------- Rows ----------

    private RenderFragment RowContent(LedgerItem i, bool pending) => __builder =>
    {
        <CategoryChip Name="@i.CategoryName" Color="@i.CategoryColor" Icon="@i.CategoryIcon" ShowName="false" Class="exp-row__chip" />
        <span class="exp-row__text">
            <span class="exp-row__name">
                @if (i.IsReadOnly)
                {
                    <a href="/deudas/@i.SourceId" title="Se edita desde la deuda">@i.Name</a>
                }
                else
                {
                    @i.Name
                }
                @if (i.Frequency is not null)
                {
                    <Badge Tone="Badge.BadgeTone.Blue" Icon="@Icons.Recurring">@UiLabels.FrequencyName(i.Frequency.Value)</Badge>
                }
                @if (pending)
                {
                    <Badge Tone="Badge.BadgeTone.Gray" Icon="@Icons.Pending">Pendiente</Badge>
                }
            </span>
            <span class="exp-row__category">@i.CategoryName</span>
        </span>
        <span class="exp-row__amount">
            <MoneyText Amount="i.Amount" Currency="i.Currency" />
            @if (i.Currency != baseCurrency)
            {
                <span class="exp-row__converted">(<MoneyText Amount="i.AmountInBase" Currency="baseCurrency" />)</span>
            }
        </span>
    };

    private IReadOnlyList<DropdownMenuItem> RowMenu(LedgerItem item) => new[]
    {
        new DropdownMenuItem("Editar", Icons.Edit, EventCallback.Factory.Create(this, () => StartEdit(item))),
        new DropdownMenuItem("Duplicar", Icons.Duplicate, EventCallback.Factory.Create(this, () => StartDuplicate(item))),
        new DropdownMenuItem("Eliminar", Icons.Delete, EventCallback.Factory.Create(this, () => StartDelete(item)), danger: true)
    };

    // ---------- Quick add ----------

    private async Task OnQuickKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(quickText))
            return;

        var (name, amount) = QuickAddParser.Parse(quickText);
        ClearMessages();
        await RunAsync(async () =>
        {
            var categoryId = await ExpenseService.GetLastCategoryIdAsync(name);
            if (categoryId is { } id && !categories.Any(c => c.Id == id && c.IsActive))
                categoryId = null;   // the last category was deactivated: let the user choose

            editingId = null;
            editingIsRecurring = false;
            input = new ExpenseInput
            {
                Name = name,
                Amount = amount ?? 0m,
                Currency = baseCurrency,
                CategoryId = categoryId ?? 0,
                Date = DateProvider.Today,
                Frequency = Frequency.Monthly
            };
            quickText = string.Empty;
            showForm = true;
        });
    }

    // ---------- Create / edit ----------

    private void StartCreate()
    {
        ClearMessages();
        editingId = null;
        editingIsRecurring = false;

        var today = DateProvider.Today;
        var inShownMonth = today.Year == CurrentYear && today.Month == CurrentMonth;
        input = new ExpenseInput
        {
            Currency = baseCurrency,
            Date = inShownMonth ? today : new DateOnly(CurrentYear, CurrentMonth, 1),
            Frequency = Frequency.Monthly
        };
        showForm = true;
    }

    private async Task StartEdit(LedgerItem item)
    {
        ClearMessages();
        await RunAsync(async () =>
        {
            var expense = await LoadExpenseAsync(item);
            editingId = expense.Id;
            editingIsRecurring = expense.IsRecurring;
            input = ToInput(expense);
            showForm = true;
        });
    }

    // A copy is a new expense with the same values (one-time ones start today).
    private async Task StartDuplicate(LedgerItem item)
    {
        ClearMessages();
        await RunAsync(async () =>
        {
            var expense = await LoadExpenseAsync(item);
            editingId = null;
            editingIsRecurring = false;
            input = ToInput(expense);
            if (!expense.IsRecurring)
                input.Date = DateProvider.Today;
            showForm = true;
        });
    }

    private async Task StartDelete(LedgerItem item)
    {
        ClearMessages();
        await RunAsync(async () =>
        {
            var expense = await LoadExpenseAsync(item);
            editingId = expense.Id;
            editingIsRecurring = expense.IsRecurring;
            AskDelete();
        });
    }

    private async Task<ExpenseDto> LoadExpenseAsync(LedgerItem item)
        => await ExpenseService.GetByIdAsync(item.SourceId)
            ?? throw new InvalidOperationException("El gasto ya no existe.");

    private static ExpenseInput ToInput(ExpenseDto expense) => new()
    {
        Name = expense.Name,
        Amount = expense.Amount,
        Currency = expense.Currency,
        CategoryId = expense.CategoryId,
        Date = expense.Date,
        IsRecurring = expense.IsRecurring,
        Frequency = expense.Frequency ?? Frequency.Monthly,
        EndDate = expense.EndDate,
        Notes = expense.Notes
    };

    private async Task SaveAsync()
    {
        formError = null;
        try
        {
            var isNew = editingId is null;
            if (isNew)
                await ExpenseService.CreateAsync(input);
            else
                await ExpenseService.UpdateAsync(editingId!.Value, input);

            CloseForm();
            message = isNew ? "Gasto guardado." : "Gasto actualizado.";
            error = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            formError = ex.Message;
        }
    }

    private void CloseForm()
    {
        showForm = false;
        formError = null;
    }

    // ---------- Delete ----------

    private void AskDelete()
    {
        if (editingId is null)
            return;

        showForm = false;
        if (editingIsRecurring)
            showRecurringDelete = true;
        else
            confirmDelete = true;
    }

    private Task DeleteAsync() => DeleteWithUndoAsync("Gasto eliminado.");

    private async Task DeleteRecurringAsync()
    {
        showRecurringDelete = false;
        await DeleteWithUndoAsync("Gasto recurrente eliminado por completo.");
    }

    private async Task EndRecurringAsync()
    {
        showRecurringDelete = false;
        await FinishDeleteAsync(() => ExpenseService.EndAsync(editingId!.Value), "Gasto recurrente finalizado; se conserva el historial.");
    }

    // Deleting offers "Deshacer": the expense is created again with the values it had.
    private async Task DeleteWithUndoAsync(string successMessage)
    {
        var id = editingId!.Value;
        ClearMessages();
        await RunAsync(async () =>
        {
            var deleted = await ExpenseService.GetByIdAsync(id);
            await ExpenseService.DeleteAsync(id);

            if (deleted is null)
                message = successMessage;
            else
                Toasts.Show(ToastKind.Success, successMessage, "Deshacer", () => UndoDeleteAsync(deleted));

            await LoadAsync();
        });
    }

    private async Task UndoDeleteAsync(ExpenseDto deleted)
    {
        try
        {
            await ExpenseService.RestoreAsync(deleted);
            Toasts.ShowSuccess("Gasto restaurado.");
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            Toasts.ShowError(ex.Message);
            return;
        }

        // The page may have been left while the toast was on screen.
        await InvokeAsync(async () =>
        {
            if (disposed)
                return;

            await RunAsync(LoadAsync);
            StateHasChanged();
        });
    }

    private bool disposed;

    public void Dispose() => disposed = true;

    private async Task FinishDeleteAsync(Func<Task> action, string successMessage)
    {
        ClearMessages();
        await RunAsync(async () =>
        {
            await action();
            message = successMessage;
            await LoadAsync();
        });
    }

    // ---------- Shared ----------

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            error = ex.Message;
        }
    }

    private void ClearMessages()
    {
        error = null;
        message = null;
        formError = null;
    }
}
