@using ExpenseTracker.Core.Application.DTOs.Expenses
@using ExpenseTracker.Core.Application.DTOs.Settings
@using ExpenseTracker.Core.Domain.Enums
@using ExpenseTracker.Web.Services

@if (Visible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="expense-title">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <EditForm Model="Model" OnValidSubmit="OnSave" FormName="expense-form">
                    <div class="modal-header">
                        <h5 class="modal-title" id="expense-title">@Title</h5>
                        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="OnCancel"></button>
                    </div>
                    <div class="modal-body">
                        <DataAnnotationsValidator />
                        <ErrorAlert Message="@Error" />
                        <ValidationSummary class="text-danger" />

                        @if (IsEditing && Model.IsRecurring)
                        {
                            <div class="alert alert-info py-2">Al editar un gasto recurrente se modifican todas sus ocurrencias.</div>
                        }

                        <div class="mb-3">
                            <label class="form-label" for="exp-name">Nombre</label>
                            <InputText id="exp-name" class="form-control" @bind-Value="Model.Name" placeholder="Supermercado" />
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-7">
                                <label class="form-label" for="exp-amount">Monto</label>
                                <InputNumber id="exp-amount" class="form-control" @bind-Value="Model.Amount" step="0.01" />
                            </div>
                            <div class="col-5">
                                <label class="form-label" for="exp-currency">Moneda</label>
                                <InputSelect id="exp-currency" class="form-select" @bind-Value="Model.Currency">
                                    @foreach (var currency in Enum.GetValues<Currency>())
                                    {
                                        <option value="@currency">@currency</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="exp-category">Categoría</label>
                            <InputSelect id="exp-category" class="form-select" @bind-Value="Model.CategoryId">
                                <option value="0">Seleccione...</option>
                                @foreach (var category in Categories.Where(c => c.IsActive || c.Id == Model.CategoryId))
                                {
                                    <option value="@category.Id">@category.Name@(category.IsActive ? "" : " (inactiva)")</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="exp-date">@(Model.IsRecurring ? "Primera ocurrencia" : "Fecha")</label>
                            <InputDate id="exp-date" class="form-control" @bind-Value="Model.Date" />
                        </div>
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox id="exp-recurring" class="form-check-input" role="switch" @bind-Value="Model.IsRecurring" />
                            <label class="form-check-label" for="exp-recurring">Es recurrente</label>
                        </div>
                        @if (Model.IsRecurring)
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <label class="form-label" for="exp-frequency">Frecuencia</label>
                                    <InputSelect id="exp-frequency" class="form-select" @bind-Value="Model.Frequency">
                                        @foreach (var frequency in Enum.GetValues<Frequency>())
                                        {
                                            <option value="@frequency">@UiLabels.FrequencyName(frequency)</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-6">
                                    <label class="form-label" for="exp-end">Fin (opcional)</label>
                                    <InputDate id="exp-end" class="form-control" @bind-Value="Model.EndDate" />
                                </div>
                            </div>
                        }
                        <div>
                            <label class="form-label" for="exp-notes">Notas</label>
                            <InputTextArea id="exp-notes" class="form-control" rows="2" @bind-Value="Model.Notes" />
                        </div>
                    </div>
                    <div class="modal-footer justify-content-between">
                        <div>
                            @if (IsEditing)
                            {
                                <button type="button" class="btn btn-outline-danger" @onclick="OnDelete">Eliminar</button>
                            }
                        </div>
                        <div>
                            <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar</button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public string Title { get; set; } = "Gasto";

    [Parameter]
    public bool IsEditing { get; set; }

    [Parameter, EditorRequired]
    public ExpenseInput Model { get; set; } = new();

    [Parameter]
    public List<CategoryDto> Categories { get; set; } = new();

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }
}
