@using System.Globalization
@using ExpenseTracker.Core.Application.DTOs.Settings
@using ExpenseTracker.Core.Application.Services
@using ExpenseTracker.Core.Domain.Enums
@inject CurrencyService CurrencyService

<section class="settings__section" aria-labelledby="settings-rates">
    <h2 id="settings-rates">Tasas de cambio</h2>
    <p class="settings__lead">
        Cuántas unidades de <strong>@BaseCurrency</strong> vale una unidad de cada moneda. Se usan para convertir los montos al registrarlos.
        Haz clic en una tasa para editarla: <kbd>Enter</kbd> guarda y <kbd>Esc</kbd> cancela.
    </p>

    <ErrorAlert @bind-Message="error" />
    <SuccessToast Message="@message" />

    @if (loading)
    {
        <Skeleton Lines="2" Height="2.5rem" />
    }
    else
    {
        <ul class="settings-list" aria-label="Tasas de cambio">
            @foreach (var currency in OtherCurrencies)
            {
                var c = currency;
                var configured = rates.TryGetValue(c, out var rate);
                <li class="settings-row">
                    <span class="settings-row__main">
                        <span class="settings-row__name">@c</span>
                        @if (editing == c)
                        {
                            <span class="plan-edit">
                                <span>1 @c =</span>
                                <input type="text" inputmode="decimal" class="field field--sm plan-edit__input @(editError is null ? null : "invalid")"
                                       aria-label="@($"Tasa de {c}")" aria-describedby="@(editError is null ? null : "rate-error")"
                                       @ref="editInput" @bind="editText" @bind:event="oninput"
                                       @onkeydown="OnEditKeyAsync" @onblur="CancelEdit" />
                                <span>@BaseCurrency</span>
                            </span>
                        }
                        else
                        {
                            <button type="button" class="plan-row__edit" @onclick="() => StartEdit(c)"
                                    aria-label="@($"Editar la tasa de {c}")" title="Clic para editar">
                                @if (configured)
                                {
                                    <span class="settings-row__value">1 @c = @rate!.RateToBase.ToString("#,##0.######", CultureInfo.CurrentCulture) @BaseCurrency</span>
                                }
                                else
                                {
                                    <span class="text-muted">Sin configurar</span>
                                }
                                <AppIcon Name="@Icons.Edit" Size="12" Class="plan-row__pencil" />
                            </button>
                        }
                    </span>
                    @if (configured)
                    {
                        <span class="text-muted">Actualizada el @rate!.UpdatedOn.ToString("d")</span>
                        <AppButton Variant="AppButton.ButtonVariant.Ghost" Size="AppButton.ButtonSize.Sm" Icon="@Icons.Delete"
                                   AriaLabel="@($"Quitar la tasa de {c}")" OnClick="() => Remove(c)" />
                    }
                </li>
                @if (editing == c && editError is not null)
                {
                    <li class="validation-message" id="rate-error" role="alert">@editError</li>
                }
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public Currency BaseCurrency { get; set; }

    private readonly Dictionary<Currency, ExchangeRateDto> rates = new();
    private Currency loadedFor = (Currency)0;
    private string? error;
    private string? message;
    private bool loading = true;

    private Currency? editing;
    private string editText = string.Empty;
    private string? editError;
    private bool focusEdit;
    private ElementReference editInput;

    private IEnumerable<Currency> OtherCurrencies => Enum.GetValues<Currency>().Where(c => c != BaseCurrency);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor != BaseCurrency)
        {
            loadedFor = BaseCurrency;
            loading = true;
            editing = null;
            await LoadAsync();
            loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusEdit)
        {
            focusEdit = false;
            await editInput.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        rates.Clear();
        foreach (var rate in await CurrencyService.ListRatesAsync())
            rates[rate.Currency] = rate;
    }

    private void StartEdit(Currency currency)
    {
        error = null;
        message = null;
        editError = null;
        editing = currency;
        editText = rates.TryGetValue(currency, out var rate) ? rate.RateToBase.ToString("0.######", CultureInfo.InvariantCulture) : string.Empty;
        focusEdit = true;
    }

    private void CancelEdit()
    {
        editing = null;
        editError = null;
    }

    private async Task OnEditKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CancelEdit();
        else if (e.Key == "Enter")
            await SaveEditAsync();
    }

    // Rates may have up to 6 decimals, so they are not read with the 2-decimal money parser.
    private async Task SaveEditAsync()
    {
        if (editing is not { } currency)
            return;

        var text = editText.Replace(",", string.Empty).Trim();
        if (!decimal.TryParse(text, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var value))
        {
            editError = "Escriba una tasa válida, por ejemplo 60.50.";
            return;
        }

        try
        {
            await CurrencyService.SetRateAsync(new ExchangeRateInput { Currency = currency, RateToBase = value });
            CancelEdit();
            await LoadAsync();
            message = $"Tasa de {currency} guardada.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            editError = ex.Message;
        }
    }

    private async Task Remove(Currency currency)
    {
        error = null;
        message = null;
        try
        {
            await CurrencyService.DeleteRateAsync(currency);
            await LoadAsync();
            message = $"Tasa de {currency} eliminada.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            error = ex.Message;
        }
    }
}
