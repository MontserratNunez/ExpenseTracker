@page "/configuracion"
@using ExpenseTracker.Core.Application.Services
@using ExpenseTracker.Core.Domain.Enums
@inject CurrencyService CurrencyService

<PageTitle>Configuración · Expense Tracker</PageTitle>

<PageHeader Title="Configuración" />

@if (loading)
{
    <Skeleton Lines="4" Height="2.5rem" />
}
else
{
    <div class="settings">
        <BaseCurrencySection BaseCurrency="baseCurrency" OnChanged="ReloadBaseCurrency" />
        <ExchangeRatesSection BaseCurrency="baseCurrency" />
        <CategoriesSection />

        <ThemeSection />
    </div>
}

@code {
    private bool loading = true;
    private Currency baseCurrency = Currency.DOP;

    protected override async Task OnInitializedAsync()
    {
        await ReloadBaseCurrency();
        loading = false;
    }

    private async Task ReloadBaseCurrency()
    {
        baseCurrency = await CurrencyService.GetBaseCurrencyAsync();
    }
}
