@using ExpenseTracker.Core.Application.DTOs.Settings
@using ExpenseTracker.Core.Application.Services
@inject CategoryService CategoryService

<section class="settings__section" aria-labelledby="settings-categories">
    <div class="home-section__head">
        <h2 id="settings-categories">Categorías</h2>
        @if (!showForm)
        {
            <AppButton OnClick="StartCreate" Icon="@Icons.Add" Size="AppButton.ButtonSize.Sm">Nueva categoría</AppButton>
        }
    </div>

    <ErrorAlert @bind-Message="error" />
    <SuccessToast Message="@message" />

    @if (showForm)
    {
        <EditForm Model="input" OnValidSubmit="SaveAsync" FormName="category-form" class="settings-editor">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />
            <AppInput Label="Nombre" @bind-Value="input.Name" />
            <ColorSwatches Label="Color" @bind-Value="input.Color" />
            <IconPicker Label="Ícono" @bind-Value="input.Icon" />
            <div class="manage-actions">
                <AppButton Type="submit">@(editingId is null ? "Crear" : "Guardar")</AppButton>
                <AppButton Variant="AppButton.ButtonVariant.Ghost" OnClick="CancelForm">Cancelar</AppButton>
            </div>
        </EditForm>
    }

    @if (loading)
    {
        <Skeleton Lines="4" Height="2.5rem" />
    }
    else if (categories.Count == 0)
    {
        <EmptyState Icon="@Icons.DefaultCategory" Title="Aún no hay categorías" Description="Crea la primera para clasificar tus gastos." />
    }
    else
    {
        <ul class="settings-list" aria-label="Categorías">
            @foreach (var category in categories)
            {
                var c = category;
                <li class="settings-row @(c.IsActive ? null : "settings-row--inactive")">
                    <span class="settings-row__main">
                        <CategoryChip Name="@c.Name" Color="@c.Color" Icon="@(c.Icon ?? Icons.DefaultCategory)" ShowName="true" />
                        @if (!c.IsActive)
                        {
                            <Badge Tone="Badge.BadgeTone.Gray">Inactiva</Badge>
                        }
                    </span>
                    <DropdownMenu AriaLabel="@($"Acciones de {c.Name}")" Items="Menu(c)" />
                </li>
            }
        </ul>
    }
</section>

<ConfirmDialog @bind-Visible="confirmDelete"
               Title="Eliminar categoría"
               Message="@($"¿Eliminar la categoría \"{pendingDelete?.Name}\"? Si tiene gastos, plan o metas asociados, solo se desactivará.")"
               ConfirmText="Eliminar"
               OnConfirm="DeleteAsync" />

@code {
    private List<CategoryDto> categories = new();
    private CategoryInput input = new();
    private int? editingId;
    private bool showForm;
    private bool loading = true;
    private string? error;
    private string? message;
    private bool confirmDelete;
    private CategoryDto? pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        loading = false;
    }

    private async Task LoadAsync() => categories = await CategoryService.ListAsync();

    private IReadOnlyList<DropdownMenuItem> Menu(CategoryDto c) => new[]
    {
        new DropdownMenuItem("Editar", Icons.Edit, EventCallback.Factory.Create(this, () => StartEdit(c))),
        new DropdownMenuItem(c.IsActive ? "Desactivar" : "Activar", c.IsActive ? Icons.Pending : Icons.Paid,
            EventCallback.Factory.Create(this, () => ToggleActive(c))),
        new DropdownMenuItem("Eliminar", Icons.Delete, EventCallback.Factory.Create(this, () => AskDelete(c)), danger: true)
    };

    private void StartCreate()
    {
        ClearMessages();
        editingId = null;
        input = new CategoryInput { Color = ColorSwatches.CategoryColors[0] };
        showForm = true;
    }

    private void StartEdit(CategoryDto category)
    {
        ClearMessages();
        editingId = category.Id;
        input = new CategoryInput
        {
            Name = category.Name,
            Color = category.Color,
            Icon = category.Icon,
        };
        showForm = true;
    }

    private void CancelForm() => showForm = false;

    private async Task SaveAsync()
    {
        await RunAsync(async () =>
        {
            if (editingId is null)
                await CategoryService.CreateAsync(input);
            else
                await CategoryService.UpdateAsync(editingId.Value, input);

            message = editingId is null ? "Categoría creada." : "Categoría actualizada.";
            showForm = false;
        });
    }

    private async Task ToggleActive(CategoryDto category)
    {
        await RunAsync(async () =>
        {
            await CategoryService.SetActiveAsync(category.Id, !category.IsActive);
            message = category.IsActive ? "Categoría desactivada." : "Categoría activada.";
        });
    }

    private void AskDelete(CategoryDto category)
    {
        ClearMessages();
        pendingDelete = category;
        confirmDelete = true;
    }

    private async Task DeleteAsync()
    {
        if (pendingDelete is null)
            return;

        var target = pendingDelete;
        await RunAsync(async () =>
        {
            var deleted = await CategoryService.DeleteAsync(target.Id);
            message = deleted
                ? "Categoría eliminada."
                : "La categoría tiene movimientos asociados; se desactivó en lugar de eliminarse.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        ClearMessages();
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            error = ex.Message;
        }
    }

    private void ClearMessages()
    {
        error = null;
        message = null;
    }
}
