@using ExpenseTracker.Core.Application.Services
@using ExpenseTracker.Core.Domain.Enums
@inject CurrencyService CurrencyService

<section class="settings__section" aria-labelledby="settings-currency">
    <h2 id="settings-currency">Moneda base</h2>
    <p class="settings__lead">Todos los totales se calculan en esta moneda. Cambiarla no recalcula los registros existentes.</p>

    <ErrorAlert @bind-Message="error" />
    <SuccessToast Message="@(saved ? "Moneda base guardada." : null)" />

    <div class="settings__row">
        <FormField Label="Moneda" InputId="base-currency">
            <select id="base-currency" class="field" @bind="selected">
                @foreach (var currency in Enum.GetValues<Currency>())
                {
                    <option value="@currency">@currency</option>
                }
            </select>
        </FormField>
        <AppButton OnClick="Save" Disabled="@(selected == BaseCurrency)">Guardar</AppButton>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public Currency BaseCurrency { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Currency selected;
    private Currency lastSeen;
    private string? error;
    private bool saved;

    protected override void OnParametersSet()
    {
        if (lastSeen != BaseCurrency)
        {
            lastSeen = BaseCurrency;
            selected = BaseCurrency;
        }
    }

    private async Task Save()
    {
        error = null;
        saved = false;
        try
        {
            await CurrencyService.SetBaseCurrencyAsync(selected);
            saved = true;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            error = ex.Message;
        }
    }
}
