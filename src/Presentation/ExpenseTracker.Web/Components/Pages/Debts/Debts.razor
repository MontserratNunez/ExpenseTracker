@page "/deudas"
@using ExpenseTracker.Core.Application.DTOs.Debts
@using ExpenseTracker.Core.Application.Interfaces
@using ExpenseTracker.Core.Application.Services
@using ExpenseTracker.Core.Domain.Enums
@using ExpenseTracker.Web.Services
@inject DebtService DebtService
@inject CurrencyService CurrencyService
@inject IDateProvider DateProvider

<PageTitle>Deudas</PageTitle>

<PageHeader Title="Deudas">
    <Actions><AppButton OnClick="StartCreate" Icon="@Icons.Add">Nueva deuda</AppButton></Actions>
</PageHeader>

<ErrorAlert @bind-Message="error" />
<SuccessToast Message="@message" />

@if (loading)
{
    <Skeleton Lines="4" Height="3rem" />
}
else if (debts.Count == 0)
{
    <EmptyState Icon="@Icons.Debts" Title="Aún no has registrado deudas" Description="Agrega un préstamo, hipoteca o tarjeta para seguir su saldo y sus cuotas.">
        <Action><AppButton OnClick="StartCreate" Icon="@Icons.Add">Nueva deuda</AppButton></Action>
    </EmptyState>
}
else
{
    <div class="debt-total">
        <StatCard Label="Deuda total pendiente" Amount="totalDebt" Currency="baseCurrency" Large="true" />
    </div>

    <div class="debt-grid">
        @foreach (var debt in debts)
        {
            var d = debt;
            <article class="card-app debt-card @(d.IsClosed ? "debt-card--closed" : null)">
                <header class="debt-card__head">
                    <h2><a href="/deudas/@d.Id">@d.Name</a></h2>
                    <span class="debt-card__badges">
                        <Badge Tone="Badge.BadgeTone.Gray">@UiLabels.DebtTypeName(d.DebtType)</Badge>
                        @if (d.IsClosed)
                        {
                            <Badge Tone="Badge.BadgeTone.Green" Icon="@Icons.Paid">Saldada</Badge>
                        }
                    </span>
                </header>

                <div class="debt-card__percent">
                    <span class="debt-card__percent-value money">@d.PaidPercent.ToString("0.#") %</span>
                    <span class="debt-card__percent-label">pagado</span>
                </div>
                <ProgressBar Percent="d.PaidPercent" Height="8" Label="@($"{d.PaidPercent:0.#}% pagado de {d.Name}")" />
                <p class="debt-card__paid">
                    <MoneyText Amount="d.PaidAmount" Currency="d.Currency" /> de <MoneyText Amount="d.OriginalAmount" Currency="d.Currency" />
                </p>

                <dl class="debt-facts">
                    <div><dt>Saldo pendiente</dt><dd><MoneyText Amount="d.RemainingBalance" Currency="d.Currency" /></dd></div>
                    <div><dt>Cuota</dt><dd><MoneyText Amount="d.MonthlyPayment" Currency="d.Currency" /></dd></div>
                    <div><dt>Tasa anual</dt><dd>@d.AnnualInterestRate.ToString("0.##") %</dd></div>
                    @if (!d.IsClosed)
                    {
                        <div><dt>Próximo pago</dt><dd>@(d.NextPaymentDate is null ? "—" : d.NextPaymentDate.Value.ToString("d"))</dd></div>
                    }
                </dl>

                <p class="debt-card__payoff @(d.IsClosed || d.EstimatedPayoffDate is not null ? null : "debt-card__payoff--warn")">
                    @if (d.IsClosed)
                    {
                        <AppIcon Name="@Icons.Paid" Size="16" />
                        <span>Deuda saldada</span>
                    }
                    else if (d.EstimatedPayoffDate is not null)
                    {
                        <AppIcon Name="@Icons.CalendarCheck" Size="16" />
                        <span>Libre de deuda en @UiLabels.MonthYear(d.EstimatedPayoffDate.Value)</span>
                    }
                    else
                    {
                        <AppIcon Name="@Icons.AtRisk" Size="16" />
                        <span>No se salda con la cuota actual</span>
                    }
                </p>

                <footer class="debt-card__foot">
                    <a href="/deudas/@d.Id" class="btn-app btn-app--secondary btn-app--sm">Ver detalle</a>
                </footer>
            </article>
        }
    </div>
}

<DebtForm Visible="showForm" Title="Nueva deuda" Model="input" Error="@formError" OnSave="SaveAsync" OnCancel="CloseForm" />

@code {
    private bool loading = true;
    private string? error;
    private string? message;
    private string? formError;

    private List<DebtDto> debts = new();
    private Currency baseCurrency = Currency.DOP;
    private decimal totalDebt;

    private bool showForm;
    private DebtInput input = new();

    protected override async Task OnInitializedAsync()
    {
        await RunAsync(LoadAsync);
        loading = false;
    }

    private async Task LoadAsync()
    {
        baseCurrency = await CurrencyService.GetBaseCurrencyAsync();
        debts = await DebtService.GetSummaryAsync();
        totalDebt = debts.Where(d => !d.IsClosed).Sum(d => d.RemainingBalanceInBase);
    }

    private void StartCreate()
    {
        error = null;
        message = null;
        formError = null;
        input = new DebtInput { Currency = baseCurrency, StartDate = DateProvider.Today };
        showForm = true;
    }

    private async Task SaveAsync()
    {
        formError = null;
        try
        {
            await DebtService.CreateAsync(input);
            showForm = false;
            message = "Deuda creada.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            formError = ex.Message;
        }
    }

    private void CloseForm()
    {
        showForm = false;
        formError = null;
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            error = ex.Message;
        }
    }
}
