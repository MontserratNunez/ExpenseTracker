@page "/deudas"
@using ExpenseTracker.Core.Application.DTOs.Debts
@using ExpenseTracker.Core.Application.Interfaces
@using ExpenseTracker.Core.Application.Services
@using ExpenseTracker.Core.Domain.Enums
@using ExpenseTracker.Web.Services
@inject DebtService DebtService
@inject CurrencyService CurrencyService
@inject IDateProvider DateProvider

<PageTitle>Deudas</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Deudas</h1>
    <button type="button" class="btn btn-primary" @onclick="StartCreate"><AppIcon Name="@Icons.Add" Size="16" /> Nueva deuda</button>
</div>

<ErrorAlert @bind-Message="error" />
<SuccessToast Message="@message" />

@if (loading)
{
    <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
}
else if (debts.Count == 0)
{
    <p class="text-muted">Aún no has registrado deudas. Usa "+ Nueva deuda" para agregar un préstamo, hipoteca o tarjeta.</p>
}
else
{
    <div class="alert alert-light border">
        Deuda total pendiente:
        <strong><MoneyText Amount="totalDebt" Currency="baseCurrency" /></strong>
    </div>

    <div class="row g-3">
        @foreach (var debt in debts)
        {
            var d = debt;
            <div class="col-12 col-lg-6">
                <div class="card h-100 @(d.IsClosed ? "border-success" : null)">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h2 class="h5 mb-1"><a href="/deudas/@d.Id" class="text-decoration-none">@d.Name</a></h2>
                                <span class="badge text-bg-secondary">@UiLabels.DebtTypeName(d.DebtType)</span>
                                @if (d.IsClosed)
                                {
                                    <span class="badge text-bg-success">Saldada</span>
                                }
                            </div>
                            <div class="text-end">
                                <div class="text-muted small">Saldo pendiente</div>
                                <div class="fs-5 fw-semibold"><MoneyText Amount="d.RemainingBalance" Currency="d.Currency" /></div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <ProgressBar Percent="d.PaidPercent" Label="@($"{d.PaidPercent:0.#}% pagado")" />
                            <div class="d-flex justify-content-between small text-muted mt-1">
                                <span>@d.PaidPercent.ToString("0.#")% pagado</span>
                                <span><MoneyText Amount="d.PaidAmount" Currency="d.Currency" /> de <MoneyText Amount="d.OriginalAmount" Currency="d.Currency" /></span>
                            </div>
                        </div>

                        <dl class="row small mt-3 mb-0">
                            <dt class="col-5 fw-normal text-muted">Tasa anual</dt>
                            <dd class="col-7">@d.AnnualInterestRate.ToString("0.##")%</dd>
                            <dt class="col-5 fw-normal text-muted">Cuota</dt>
                            <dd class="col-7"><MoneyText Amount="d.MonthlyPayment" Currency="d.Currency" /></dd>
                            @if (!d.IsClosed)
                            {
                                <dt class="col-5 fw-normal text-muted">Próximo pago</dt>
                                <dd class="col-7">@(d.NextPaymentDate is null ? "—" : d.NextPaymentDate.Value.ToString("d"))</dd>
                                <dt class="col-5 fw-normal text-muted">Saldo estimado</dt>
                                <dd class="col-7">
                                    @if (d.EstimatedPayoffDate is not null)
                                    {
                                        @UiLabels.MonthYear(d.EstimatedPayoffDate.Value)
                                    }
                                    else
                                    {
                                        <span class="text-warning-emphasis">No se salda con la cuota actual</span>
                                    }
                                </dd>
                            }
                        </dl>
                    </div>
                    <div class="card-footer text-end bg-transparent">
                        <a href="/deudas/@d.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<DebtForm Visible="showForm" Title="Nueva deuda" Model="input" Error="@formError" OnSave="SaveAsync" OnCancel="CloseForm" />

@code {
    private bool loading = true;
    private string? error;
    private string? message;
    private string? formError;

    private List<DebtDto> debts = new();
    private Currency baseCurrency = Currency.DOP;
    private decimal totalDebt;

    private bool showForm;
    private DebtInput input = new();

    protected override async Task OnInitializedAsync()
    {
        await RunAsync(LoadAsync);
        loading = false;
    }

    private async Task LoadAsync()
    {
        baseCurrency = await CurrencyService.GetBaseCurrencyAsync();
        debts = await DebtService.GetSummaryAsync();
        totalDebt = debts.Where(d => !d.IsClosed).Sum(d => d.RemainingBalanceInBase);
    }

    private void StartCreate()
    {
        error = null;
        message = null;
        formError = null;
        input = new DebtInput { Currency = baseCurrency, StartDate = DateProvider.Today };
        showForm = true;
    }

    private async Task SaveAsync()
    {
        formError = null;
        try
        {
            await DebtService.CreateAsync(input);
            showForm = false;
            message = "Deuda creada.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            formError = ex.Message;
        }
    }

    private void CloseForm()
    {
        showForm = false;
        formError = null;
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            error = ex.Message;
        }
    }
}
