@page "/deudas/{id:int}"
@using ExpenseTracker.Core.Application.DTOs.Debts
@using ExpenseTracker.Core.Application.Interfaces
@using ExpenseTracker.Core.Application.Services
@using ExpenseTracker.Core.Domain.Enums
@using ExpenseTracker.Web.Services
@inject DebtService DebtService
@inject IDateProvider DateProvider
@inject NavigationManager Navigation

<PageTitle>@(detail?.Debt.Name ?? "Deuda")</PageTitle>

<p class="mb-2"><a href="/deudas"><AppIcon Name="@Icons.Previous" Size="14" /> Volver a deudas</a></p>

<ErrorAlert @bind-Message="error" />
<SuccessToast Message="@message" />

@if (loading)
{
    <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
}
else if (detail is not null)
{
    var d = detail.Debt;

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h1 class="mb-1">@d.Name</h1>
            <span class="badge text-bg-secondary">@UiLabels.DebtTypeName(d.DebtType)</span>
            @if (d.IsClosed)
            {
                <span class="badge text-bg-success">Saldada</span>
            }
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-primary" @onclick="StartPayment" disabled="@d.IsClosed">Registrar pago</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="StartEdit">Editar</button>
            <button type="button" class="btn btn-outline-danger" @onclick="() => confirmDeleteDebt = true">Eliminar</button>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <ProgressBar Percent="d.PaidPercent" Label="@($"{d.PaidPercent:0.#}% pagado")" Height="14" />
            <div class="d-flex justify-content-between small text-muted mt-1 mb-3">
                <span>@d.PaidPercent.ToString("0.#")% pagado</span>
                <span><MoneyText Amount="d.PaidAmount" Currency="d.Currency" /> de <MoneyText Amount="d.OriginalAmount" Currency="d.Currency" /></span>
            </div>

            <dl class="row mb-0">
                <dt class="col-sm-3 fw-normal text-muted">Saldo pendiente</dt>
                <dd class="col-sm-3 fw-semibold"><MoneyText Amount="d.RemainingBalance" Currency="d.Currency" /></dd>
                <dt class="col-sm-3 fw-normal text-muted">Cuota mensual</dt>
                <dd class="col-sm-3"><MoneyText Amount="d.MonthlyPayment" Currency="d.Currency" /></dd>

                <dt class="col-sm-3 fw-normal text-muted">Tasa anual</dt>
                <dd class="col-sm-3">@d.AnnualInterestRate.ToString("0.##")%</dd>
                <dt class="col-sm-3 fw-normal text-muted">Día de pago</dt>
                <dd class="col-sm-3">@d.PaymentDay</dd>

                <dt class="col-sm-3 fw-normal text-muted">Inicio</dt>
                <dd class="col-sm-3">@d.StartDate.ToString("d")</dd>
                <dt class="col-sm-3 fw-normal text-muted">Plazo</dt>
                <dd class="col-sm-3">@(d.TermMonths is null ? "—" : $"{d.TermMonths} meses")</dd>

                @if (!d.IsClosed)
                {
                    <dt class="col-sm-3 fw-normal text-muted">Próximo pago</dt>
                    <dd class="col-sm-3">@(d.NextPaymentDate is null ? "—" : d.NextPaymentDate.Value.ToString("d"))</dd>
                    <dt class="col-sm-3 fw-normal text-muted">Saldo estimado</dt>
                    <dd class="col-sm-3">
                        @if (d.EstimatedPayoffDate is not null)
                        {
                            @UiLabels.MonthYear(d.EstimatedPayoffDate.Value)
                        }
                        else
                        {
                            <span class="text-warning-emphasis">No se salda con la cuota actual</span>
                        }
                    </dd>
                }
            </dl>
        </div>
    </div>

    <h2 class="h5">Historial de pagos</h2>
    @if (detail.Payments.Count == 0)
    {
        <p class="text-muted">Aún no hay pagos registrados.</p>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table align-middle">
                <thead>
                    <tr><th>Fecha</th><th class="text-end">Monto</th><th class="text-end">Interés</th><th class="text-end">Capital</th><th>Notas</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var payment in detail.Payments)
                    {
                        var p = payment;
                        <tr>
                            <td>@p.Date.ToString("d")</td>
                            <td class="text-end"><MoneyText Amount="p.Amount" Currency="d.Currency" /></td>
                            <td class="text-end"><MoneyText Amount="p.InterestPortion" Currency="d.Currency" /></td>
                            <td class="text-end"><MoneyText Amount="p.PrincipalPortion" Currency="d.Currency" /></td>
                            <td>@p.Notes</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => AskDeletePayment(p)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <button type="button" class="btn btn-outline-secondary mb-3" @onclick="ToggleAmortizationAsync" aria-expanded="@showAmortization">
        @(showAmortization ? "Ocultar" : "Ver") tabla de amortización
    </button>
    @if (showAmortization)
    {
        @if (amortization is null)
        {
            <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
        }
        else if (amortization.Rows.Count == 0)
        {
            <p class="text-muted">No hay cuotas pendientes.</p>
        }
        else
        {
            @if (!amortization.PaysOff)
            {
                <div class="alert alert-warning">
                    La cuota actual no cubre los intereses, por lo que el saldo no baja.
                    @if (amortization.Truncated)
                    {
                        <span>Se muestran solo las primeras @amortization.Rows.Count cuotas.</span>
                    }
                </div>
            }
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr><th>Fecha</th><th class="text-end">Cuota</th><th class="text-end">Interés</th><th class="text-end">Capital</th><th class="text-end">Saldo</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in amortization.Rows)
                        {
                            <tr>
                                <td>@row.Date.ToString("d")</td>
                                <td class="text-end"><MoneyText Amount="row.Payment" Currency="d.Currency" /></td>
                                <td class="text-end"><MoneyText Amount="row.Interest" Currency="d.Currency" /></td>
                                <td class="text-end"><MoneyText Amount="row.Principal" Currency="d.Currency" /></td>
                                <td class="text-end"><MoneyText Amount="row.Balance" Currency="d.Currency" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

<DebtForm Visible="showEdit" Title="Editar deuda" Model="debtInput" Error="@formError" OnSave="SaveEditAsync" OnCancel="CloseForms" />
<DebtPaymentForm Visible="showPayment" Model="paymentInput" Currency="detail?.Debt.Currency ?? Currency.DOP" Error="@formError" OnSave="SavePaymentAsync" OnCancel="CloseForms" />

<ConfirmDialog @bind-Visible="confirmDeleteDebt" Title="Eliminar deuda"
               Message="¿Eliminar esta deuda y todo su historial de pagos? Los pagos desaparecerán también de los gastos de cada mes."
               ConfirmText="Eliminar" OnConfirm="DeleteDebtAsync" />

<ConfirmDialog @bind-Visible="confirmDeletePayment" Title="Eliminar pago"
               Message="@deletePaymentMessage" ConfirmText="Eliminar" OnConfirm="DeletePaymentAsync" />

@code {
    [Parameter]
    public int Id { get; set; }

    private bool loading = true;
    private string? error;
    private string? message;
    private string? formError;

    private DebtDetailDto? detail;
    private AmortizationDto? amortization;
    private bool showAmortization;

    private bool showEdit;
    private DebtInput debtInput = new();
    private bool showPayment;
    private DebtPaymentInput paymentInput = new();

    private bool confirmDeleteDebt;
    private bool confirmDeletePayment;
    private string deletePaymentMessage = string.Empty;
    private DebtPaymentDto? pendingPayment;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        detail = null;
        amortization = null;
        showAmortization = false;
        await RunAsync(LoadAsync);
        loading = false;
    }

    private async Task LoadAsync()
    {
        detail = await DebtService.TryGetDetailAsync(Id);
        if (detail is null)
        {
            // Missing, or it belongs to another user: the global filter makes both look the same (404).
            Navigation.NotFound();
            return;
        }

        amortization = showAmortization ? await DebtService.GetAmortizationAsync(Id) : null;
    }

    private async Task ToggleAmortizationAsync()
    {
        showAmortization = !showAmortization;
        if (showAmortization && amortization is null)
            await RunAsync(async () => amortization = await DebtService.GetAmortizationAsync(Id));
    }

    // ---------- Edit ----------

    private void StartEdit()
    {
        ClearMessages();
        var d = detail!.Debt;
        debtInput = new DebtInput
        {
            Name = d.Name,
            DebtType = d.DebtType,
            OriginalAmount = d.OriginalAmount,
            AnnualInterestRate = d.AnnualInterestRate,
            InitialPaidAmount = d.InitialPaidAmount,
            MonthlyPayment = d.MonthlyPayment,
            PaymentDay = d.PaymentDay,
            StartDate = d.StartDate,
            TermMonths = d.TermMonths,
            Currency = d.Currency
        };
        showEdit = true;
    }

    private Task SaveEditAsync() => SaveFormAsync(async () =>
    {
        await DebtService.UpdateAsync(Id, debtInput);
        message = "Deuda actualizada.";
    });

    // ---------- Payments ----------

    private void StartPayment()
    {
        ClearMessages();
        paymentInput = new DebtPaymentInput { Amount = detail!.Debt.SuggestedPayment, Date = DateProvider.Today };
        showPayment = true;
    }

    private Task SavePaymentAsync() => SaveFormAsync(async () =>
    {
        await DebtService.RegisterPaymentAsync(Id, paymentInput);
        message = "Pago registrado.";
    });

    private void AskDeletePayment(DebtPaymentDto payment)
    {
        ClearMessages();
        pendingPayment = payment;
        deletePaymentMessage = $"¿Eliminar el pago del {payment.Date:d}? El saldo de la deuda se recalculará.";
        confirmDeletePayment = true;
    }

    private async Task DeletePaymentAsync()
    {
        if (pendingPayment is null)
            return;

        var payment = pendingPayment;
        await RunAsync(async () =>
        {
            await DebtService.DeletePaymentAsync(Id, payment.Id);
            message = "Pago eliminado.";
            await LoadAsync();
        });
    }

    // ---------- Delete debt ----------

    private async Task DeleteDebtAsync()
    {
        await RunAsync(async () =>
        {
            await DebtService.DeleteAsync(Id);
            Navigation.NavigateTo("/deudas");
        });
    }

    // ---------- Shared ----------

    // Keeps the modal open and shows the error inside it when saving fails.
    private async Task SaveFormAsync(Func<Task> save)
    {
        formError = null;
        try
        {
            await save();
            CloseForms();
            error = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            formError = ex.Message;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            error = ex.Message;
        }
    }

    private void CloseForms()
    {
        showEdit = false;
        showPayment = false;
        formError = null;
    }

    private void ClearMessages()
    {
        error = null;
        message = null;
        formError = null;
    }
}
