@page "/deudas/{id:int}"
@using ExpenseTracker.Core.Application.DTOs.Debts
@using ExpenseTracker.Core.Application.Interfaces
@using ExpenseTracker.Core.Application.Services
@using ExpenseTracker.Core.Domain.Enums
@using ExpenseTracker.Web.Services
@inject DebtService DebtService
@inject IDateProvider DateProvider
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>@(detail?.Debt.Name ?? "Deuda")</PageTitle>

<p class="debt-back"><a href="/deudas"><AppIcon Name="@Icons.Previous" Size="14" /> Volver a deudas</a></p>

<ErrorAlert @bind-Message="error" />
<SuccessToast Message="@message" />

@if (loading)
{
    <Skeleton Lines="4" Height="3rem" />
}
else if (detail is not null)
{
    var d = detail.Debt;

    <PageHeader Title="@d.Name">
        <Actions>
            <AppButton OnClick="StartPayment" Disabled="@d.IsClosed">Registrar pago</AppButton>
            <AppButton Variant="AppButton.ButtonVariant.Secondary" OnClick="StartEdit">Editar</AppButton>
            <AppButton Variant="AppButton.ButtonVariant.Danger" OnClick="() => confirmDeleteDebt = true">Eliminar</AppButton>
        </Actions>
    </PageHeader>
    <div class="debt-badges">
        <Badge Tone="Badge.BadgeTone.Gray">@UiLabels.DebtTypeName(d.DebtType)</Badge>
        @if (d.IsClosed)
        {
            <Badge Tone="Badge.BadgeTone.Green" Icon="@Icons.Paid">Saldada</Badge>
        }
    </div>

    <section class="card-app debt-summary" aria-label="Resumen de la deuda">
        <div class="debt-card__percent">
            <span class="debt-card__percent-value money">@d.PaidPercent.ToString("0.#") %</span>
            <span class="debt-card__percent-label">pagado</span>
        </div>
        <ProgressBar Percent="d.PaidPercent" Label="@($"{d.PaidPercent:0.#}% pagado")" Height="8" />
        <p class="debt-card__paid">
            <MoneyText Amount="d.PaidAmount" Currency="d.Currency" /> de <MoneyText Amount="d.OriginalAmount" Currency="d.Currency" />
        </p>

        <dl class="debt-facts debt-facts--wide">
            <div><dt>Saldo pendiente</dt><dd><MoneyText Amount="d.RemainingBalance" Currency="d.Currency" /></dd></div>
            <div><dt>Cuota mensual</dt><dd><MoneyText Amount="d.MonthlyPayment" Currency="d.Currency" /></dd></div>
            <div><dt>Tasa anual</dt><dd>@d.AnnualInterestRate.ToString("0.##") %</dd></div>
            <div><dt>Día de pago</dt><dd>@d.PaymentDay</dd></div>
            <div><dt>Inicio</dt><dd>@d.StartDate.ToString("d")</dd></div>
            <div><dt>Plazo</dt><dd>@(d.TermMonths is null ? "—" : $"{d.TermMonths} meses")</dd></div>
            @if (!d.IsClosed)
            {
                <div><dt>Próximo pago</dt><dd>@(d.NextPaymentDate is null ? "—" : d.NextPaymentDate.Value.ToString("d"))</dd></div>
            }
        </dl>

        <p class="debt-card__payoff @(d.IsClosed || d.EstimatedPayoffDate is not null ? null : "debt-card__payoff--warn")">
            @if (d.IsClosed)
            {
                <AppIcon Name="@Icons.Paid" Size="16" />
                <span>Deuda saldada</span>
            }
            else if (d.EstimatedPayoffDate is not null)
            {
                <AppIcon Name="@Icons.CalendarCheck" Size="16" />
                <span>Libre de deuda en @UiLabels.MonthYear(d.EstimatedPayoffDate.Value)</span>
            }
            else
            {
                <AppIcon Name="@Icons.AtRisk" Size="16" />
                <span>No se salda con la cuota actual</span>
            }
        </p>
    </section>

    <h2>Historial de pagos</h2>
    @if (detail.Payments.Count == 0)
    {
        <EmptyState Icon="@Icons.Paid" Title="Aún no hay pagos registrados" />
    }
    else
    {
        <ul class="payment-list" aria-label="Historial de pagos">
            @foreach (var payment in detail.Payments)
            {
                var p = payment;
                <li class="payment-row">
                    <span class="payment-row__date">@p.Date.ToString("d")</span>
                    <span class="payment-row__split">
                        Interés <MoneyText Amount="p.InterestPortion" Currency="d.Currency" />
                        <span aria-hidden="true"><span aria-hidden="true">·</span>nbsp;·<span aria-hidden="true">·</span>nbsp;</span>
                        Capital <MoneyText Amount="p.PrincipalPortion" Currency="d.Currency" />
                        @if (!string.IsNullOrWhiteSpace(p.Notes))
                        {
                            <span class="payment-row__notes">@p.Notes</span>
                        }
                    </span>
                    <span class="payment-row__amount"><MoneyText Amount="p.Amount" Currency="d.Currency" /></span>
                    <AppButton Variant="AppButton.ButtonVariant.Ghost" Size="AppButton.ButtonSize.Sm" Icon="@Icons.Delete"
                               AriaLabel="@($"Eliminar el pago del {p.Date:d}")" OnClick="() => AskDeletePayment(p)" />
                </li>
            }
        </ul>
    }

    <div class="debt-amort-toggle">
        <AppButton Variant="AppButton.ButtonVariant.Secondary" OnClick="ToggleAmortizationAsync">
            @(showAmortization ? "Ocultar" : "Ver") tabla de amortización
        </AppButton>
    </div>
    @if (showAmortization)
    {
        @if (amortization is null)
        {
            <Skeleton Lines="4" Height="2.5rem" />
        }
        else if (amortization.Rows.Count == 0)
        {
            <EmptyState Icon="@Icons.OnTrack" Title="No hay cuotas pendientes" />
        }
        else
        {
            @if (!amortization.PaysOff)
            {
                <InlineAlert Tone="InlineAlert.AlertTone.Warning" Class="debt-alert">
                    La cuota actual no cubre los intereses, por lo que el saldo no baja.
                    @if (amortization.Truncated)
                    {
                        <span>Se muestran solo las primeras @amortization.Rows.Count cuotas.</span>
                    }
                </InlineAlert>
            }
            var today = DateProvider.Today;
            <div class="amort" tabindex="0" role="region" aria-label="Tabla de amortización">
                <table class="amort__table">
                    <thead>
                        <tr><th scope="col">Fecha</th><th scope="col" class="num">Cuota</th><th scope="col" class="num">Interés</th><th scope="col" class="num">Capital</th><th scope="col" class="num">Saldo</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in amortization.Rows)
                        {
                            var isCurrent = row.Date.Year == today.Year && row.Date.Month == today.Month;
                            <tr class="@(isCurrent ? "amort__current" : null)" aria-current="@(isCurrent ? "date" : null)">
                                <td>
                                    @row.Date.ToString("d")
                                    @if (isCurrent)
                                    {
                                        <Badge Tone="Badge.BadgeTone.Blue">Este mes</Badge>
                                    }
                                </td>
                                <td class="num"><MoneyText Amount="row.Payment" Currency="d.Currency" /></td>
                                <td class="num"><MoneyText Amount="row.Interest" Currency="d.Currency" /></td>
                                <td class="num"><MoneyText Amount="row.Principal" Currency="d.Currency" /></td>
                                <td class="num"><MoneyText Amount="row.Balance" Currency="d.Currency" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

<DebtForm Visible="showEdit" Title="Editar deuda" Model="debtInput" Error="@formError" OnSave="SaveEditAsync" OnCancel="CloseForms" />
<DebtPaymentForm Visible="showPayment" Model="paymentInput" Currency="detail?.Debt.Currency ?? Currency.DOP" Error="@formError" OnSave="SavePaymentAsync" OnCancel="CloseForms" />

<ConfirmDialog @bind-Visible="confirmDeleteDebt" Title="Eliminar deuda"
               Message="¿Eliminar esta deuda y todo su historial de pagos? Los pagos desaparecerán también de los gastos de cada mes."
               ConfirmText="Eliminar" OnConfirm="DeleteDebtAsync" />

<ConfirmDialog @bind-Visible="confirmDeletePayment" Title="Eliminar pago"
               Message="@deletePaymentMessage" ConfirmText="Eliminar" OnConfirm="DeletePaymentAsync" />

@code {
    [Parameter]
    public int Id { get; set; }

    private bool loading = true;
    private string? error;
    private string? message;
    private string? formError;

    private DebtDetailDto? detail;
    private AmortizationDto? amortization;
    private bool showAmortization;

    private bool showEdit;
    private DebtInput debtInput = new();
    private bool showPayment;
    private DebtPaymentInput paymentInput = new();

    private bool confirmDeleteDebt;
    private bool confirmDeletePayment;
    private string deletePaymentMessage = string.Empty;
    private DebtPaymentDto? pendingPayment;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        detail = null;
        amortization = null;
        showAmortization = false;
        await RunAsync(LoadAsync);
        loading = false;
    }

    private async Task LoadAsync()
    {
        detail = await DebtService.TryGetDetailAsync(Id);
        if (detail is null)
        {
            // Missing, or it belongs to another user: the global filter makes both look the same (404).
            Navigation.NotFound();
            return;
        }

        amortization = showAmortization ? await DebtService.GetAmortizationAsync(Id) : null;
    }

    private async Task ToggleAmortizationAsync()
    {
        showAmortization = !showAmortization;
        if (showAmortization && amortization is null)
            await RunAsync(async () => amortization = await DebtService.GetAmortizationAsync(Id));
    }

    // ---------- Edit ----------

    private void StartEdit()
    {
        ClearMessages();
        var d = detail!.Debt;
        debtInput = new DebtInput
        {
            Name = d.Name,
            DebtType = d.DebtType,
            OriginalAmount = d.OriginalAmount,
            AnnualInterestRate = d.AnnualInterestRate,
            InitialPaidAmount = d.InitialPaidAmount,
            MonthlyPayment = d.MonthlyPayment,
            PaymentDay = d.PaymentDay,
            StartDate = d.StartDate,
            TermMonths = d.TermMonths,
            Currency = d.Currency
        };
        showEdit = true;
    }

    private Task SaveEditAsync() => SaveFormAsync(async () =>
    {
        await DebtService.UpdateAsync(Id, debtInput);
        message = "Deuda actualizada.";
    });

    // ---------- Payments ----------

    private void StartPayment()
    {
        ClearMessages();
        paymentInput = new DebtPaymentInput { Amount = detail!.Debt.SuggestedPayment, Date = DateProvider.Today };
        showPayment = true;
    }

    private Task SavePaymentAsync() => SaveFormAsync(async () =>
    {
        await DebtService.RegisterPaymentAsync(Id, paymentInput);
        message = "Pago registrado.";
    });

    private void AskDeletePayment(DebtPaymentDto payment)
    {
        ClearMessages();
        pendingPayment = payment;
        deletePaymentMessage = $"¿Eliminar el pago del {payment.Date:d}? El saldo de la deuda se recalculará.";
        confirmDeletePayment = true;
    }

    private async Task DeletePaymentAsync()
    {
        if (pendingPayment is null)
            return;

        var payment = pendingPayment;
        await RunAsync(async () =>
        {
            await DebtService.DeletePaymentAsync(Id, payment.Id);
            message = "Pago eliminado.";
            await LoadAsync();
        });
    }

    // ---------- Delete debt ----------

    private async Task DeleteDebtAsync()
    {
        await RunAsync(async () =>
        {
            await DebtService.DeleteAsync(Id);
            Toasts.ShowSuccess("Deuda eliminada.");   // the toast host lives in the layout, so it survives the navigation
            Navigation.NavigateTo("/deudas");
        });
    }

    // ---------- Shared ----------

    // Keeps the modal open and shows the error inside it when saving fails.
    private async Task SaveFormAsync(Func<Task> save)
    {
        formError = null;
        try
        {
            await save();
            CloseForms();
            error = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            formError = ex.Message;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            error = ex.Message;
        }
    }

    private void CloseForms()
    {
        showEdit = false;
        showPayment = false;
        formError = null;
    }

    private void ClearMessages()
    {
        error = null;
        message = null;
        formError = null;
    }
}
