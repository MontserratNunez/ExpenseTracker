@page "/metas"
@using ExpenseTracker.Core.Application.DTOs.Goals
@using ExpenseTracker.Core.Application.DTOs.Settings
@using ExpenseTracker.Core.Application.Interfaces
@using ExpenseTracker.Core.Application.Services
@using ExpenseTracker.Core.Domain.Enums
@using ExpenseTracker.Web.Services
@inject GoalService GoalService
@inject CategoryService CategoryService
@inject CurrencyService CurrencyService
@inject IDateProvider DateProvider
@implements IDisposable
@inject UiInterop Ui

<PageTitle>Metas · Expense Tracker</PageTitle>

<PageHeader Title="Metas">
    <Actions><AppButton OnClick="StartCreate" Icon="@Icons.Add" Disabled="@loading">Nueva meta</AppButton></Actions>
</PageHeader>

<ErrorAlert @bind-Message="error" />
<SuccessToast Message="@message" />

@if (loading)
{
    <div class="goal-grid">
        <Skeleton Height="11rem" />
        <Skeleton Height="11rem" />
    </div>
}
else if (statuses.Count == 0)
{
    <EmptyState Icon="@Icons.EmptyGoals" Title="Aún no tienes metas" Description="Crea una, por ejemplo Ahorro de 200,000 anualmente, y sigue tu avance mes a mes.">
        <Action><AppButton OnClick="StartCreate" Icon="@Icons.Add">Nueva meta</AppButton></Action>
    </EmptyState>
}
else
{
    <div class="goal-grid">
        @foreach (var status in statuses)
        {
            var s = status;
            var state = StateInfo(s.State);
            <article class="card-app goal-card">
                <header class="goal-card__top">
                    <div class="goal-card__ring">
                        <PieChart Size="72" StrokeWidth="4.5m" ShowLegend="false" Currency="baseCurrency"
                                  Slices="RingSlices(s)">
                            <CenterContent><AppIcon Name="@(s.Goal.Icon ?? Icons.Goals)" Size="24" /></CenterContent>
                        </PieChart>
                        @if (celebrating.Contains(s.Goal.Id))
                        {
                            <span class="confetti" aria-hidden="true">
                                @for (var i = 0; i < ConfettiCount; i++)
                                {
                                    <i style="@ConfettiStyle(i)"></i>
                                }
                            </span>
                        }
                    </div>
                    <div class="goal-card__title">
                        <h2>@s.Goal.Name</h2>
                        <p>
                            @UiLabels.GoalPeriodName(s.Goal.Period) · @s.Goal.CategoryName ·
                            @s.Goal.StartDate.ToString("d") – @s.Goal.EndDate.ToString("d")
                        </p>
                    </div>
                    <DropdownMenu AriaLabel="@($"Acciones de {s.Goal.Name}")" Items="GoalMenu(s.Goal)" />
                </header>

                <p class="goal-card__amounts">
                    <MoneyText Amount="s.Progress" Currency="baseCurrency" /> de
                    <MoneyText Amount="s.Goal.TargetAmount" Currency="baseCurrency" />
                    <span class="text-muted">(@s.ProgressPercent.ToString("0.#") %)</span>
                </p>

                <Badge Tone="state.Tone" Icon="@state.Icon" Class="goal-card__state">@state.Text</Badge>

                @if (s.State is GoalState.OnTrack or GoalState.Behind or GoalState.NotStarted)
                {
                    <p class="goal-card__need">
                        @if (s.Goal.Period == GoalPeriod.Monthly)
                        {
                            <text>Te faltan <strong><MoneyText Amount="s.RequiredMonthly" Currency="baseCurrency" /></strong> este mes</text>
                        }
                        else
                        {
                            <text>Necesitas <strong><MoneyText Amount="s.RequiredMonthly" Currency="baseCurrency" />/mes</strong>
                                durante @s.RemainingMonths @(s.RemainingMonths == 1 ? "mes" : "meses")</text>
                        }
                    </p>
                    @if (s.State != GoalState.NotStarted)
                    {
                        <p class="goal-card__projection">
                            Proyección: <MoneyText Amount="s.Projection" Currency="baseCurrency" />
                            @if (s.Goal.Period != GoalPeriod.Monthly)
                            {
                                <text>(promedio <MoneyText Amount="s.AverageMonthly" Currency="baseCurrency" />/mes)</text>
                            }
                        </p>
                    }
                }
                else if (s.State == GoalState.Completed)
                {
                    <p class="goal-card__need">Meta alcanzada. Buen trabajo.</p>
                }
                else if (s.State == GoalState.Missed)
                {
                    <p class="goal-card__need">
                        El periodo terminó y faltaron <MoneyText Amount="s.Shortfall" Currency="baseCurrency" />.
                    </p>
                }

                @if (s.PlanBelowRequired && s.PlannedMonthly is not null)
                {
                    <InlineAlert Tone="InlineAlert.AlertTone.Warning">
                        Tu plan asigna <MoneyText Amount="s.PlannedMonthly.Value" Currency="baseCurrency" />/mes a @s.Goal.CategoryName;
                        la meta necesita <MoneyText Amount="s.RequiredMonthly" Currency="baseCurrency" />/mes.
                        <a href="/plan">Ajustar el plan</a>
                    </InlineAlert>
                }
            </article>
        }
    </div>
}

<GoalForm Visible="showForm" Title="@(editingId is null ? "Nueva meta" : "Editar meta")" Model="input"
          Categories="categories" Currency="baseCurrency" Error="@formError" OnSave="SaveAsync" OnCancel="CloseForm" />

<ConfirmDialog @bind-Visible="confirmDelete" Title="Eliminar meta" Message="@deleteMessage"
               ConfirmText="Eliminar" OnConfirm="DeleteAsync" />

@code {
    private const int ConfettiCount = 16;

    private bool loading = true;
    private string? error;
    private string? message;
    private string? formError;

    private Currency baseCurrency = Currency.DOP;
    private List<GoalStatusDto> statuses = new();
    private List<CategoryDto> categories = new();

    private bool showForm;
    private int? editingId;
    private GoalInput input = new();

    private bool confirmDelete;
    private string deleteMessage = string.Empty;
    private GoalDto? pendingDelete;

    // Goals that are playing their one-time celebration right now.
    private readonly HashSet<int> celebrating = new();
    private bool celebrationChecked;
    private bool disposed;

    protected override async Task OnInitializedAsync()
    {
        await RunAsync(LoadAsync);
        loading = false;
    }

    // The celebration needs the browser (localStorage), so it runs after the first interactive render with data.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (celebrationChecked || loading)
            return;

        celebrationChecked = true;
        foreach (var done in statuses.Where(s => s.State == GoalState.Completed))
        {
            if (await Ui.ClaimCelebrationAsync($"goal-{done.Goal.Id}"))
                celebrating.Add(done.Goal.Id);
        }

        if (celebrating.Count == 0)
            return;

        StateHasChanged();
        await Task.Delay(1500);
        if (!disposed)
        {
            celebrating.Clear();
            StateHasChanged();
        }
    }

    public void Dispose() => disposed = true;

    private async Task LoadAsync()
    {
        baseCurrency = await CurrencyService.GetBaseCurrencyAsync();
        categories = await CategoryService.ListAsync(includeInactive: false);
        statuses = await GoalService.GetGoalsStatusAsync();
    }

    // The state is shown with an icon and words, and a color that only reinforces it.
    private static (string Text, Badge.BadgeTone Tone, string Icon, string ColorVar) StateInfo(GoalState state) => state switch
    {
        GoalState.OnTrack => ("En camino", Badge.BadgeTone.Green, Icons.GoalOnTrack, "--color-available"),
        GoalState.Completed => ("Lograda", Badge.BadgeTone.Green, Icons.GoalDone, "--color-available"),
        GoalState.NotStarted => ("No iniciada", Badge.BadgeTone.Gray, Icons.Pending, "--color-text-subtle"),
        GoalState.Missed => ("No lograda", Badge.BadgeTone.Red, Icons.Error, "--color-spent"),
        _ => ("Atrasada", Badge.BadgeTone.Amber, Icons.GoalBehind, "--color-warning")
    };

    private IReadOnlyList<DropdownMenuItem> GoalMenu(GoalDto goal) => new[]
    {
        new DropdownMenuItem("Editar", Icons.Edit, EventCallback.Factory.Create(this, () => StartEditAsync(goal.Id))),
        new DropdownMenuItem("Eliminar", Icons.Delete, EventCallback.Factory.Create(this, () => AskDelete(goal)), danger: true)
    };

    // The ring: what is done in the color of the state and what is missing in the neutral track color.
    private static List<PieSlice> RingSlices(GoalStatusDto s)
    {
        var done = Math.Min(s.Progress, s.Goal.TargetAmount);
        return new List<PieSlice>
        {
            new() { Label = "Logrado", Value = done, Color = "var(" + StateInfo(s.State).ColorVar + ")" },
            new() { Label = "Falta", Value = Math.Max(0m, s.Goal.TargetAmount - done), Color = "var(--color-bg-hover)" }
        };
    }

    // Each piece flies out of the ring in its own direction, a little different from its neighbors.
    private static string ConfettiStyle(int i)
    {
        var angle = i * (360.0 / ConfettiCount) + (i % 2 == 0 ? 0 : 11);
        var radius = 38 + (i % 3) * 14;
        var x = (int)Math.Round(Math.Cos(angle * Math.PI / 180) * radius);
        var y = (int)Math.Round(Math.Sin(angle * Math.PI / 180) * radius);
        var color = (i % 3) switch { 0 => "--color-primary-500", 1 => "--color-primary-100", _ => "--color-primary-700" };
        return $"--x:{x}px;--y:{y}px;--spin:{(i * 47) % 360}deg;--delay:{(i % 4) * 40}ms;background:var({color})";
    }

    // ---------- Create / edit ----------

    private void StartCreate()
    {
        ClearMessages();
        editingId = null;

        var today = DateProvider.Today;
        input = new GoalInput
        {
            Period = GoalPeriod.Annual,
            Year = today.Year,
            StartDate = today,
            EndDate = new DateOnly(today.Year, 12, 31),
            // The savings category and its icon by default.
            CategoryId = categories.FirstOrDefault(c => c.IsSavings)?.Id ?? 0,
            Icon = Icons.EmptyGoals
        };
        showForm = true;
    }

    private async Task StartEditAsync(int id)
    {
        ClearMessages();
        await RunAsync(async () =>
        {
            var goal = await GoalService.GetByIdAsync(id) ?? throw new InvalidOperationException("La meta ya no existe.");

            editingId = goal.Id;
            input = new GoalInput
            {
                Name = goal.Name,
                TargetAmount = goal.TargetAmount,
                Period = goal.Period,
                Year = goal.StartDate.Year,
                StartDate = goal.StartDate,
                EndDate = goal.EndDate,
                CategoryId = goal.CategoryId ?? 0,
                Icon = goal.Icon
            };
            showForm = true;
        });
    }

    private async Task SaveAsync()
    {
        formError = null;
        try
        {
            var isNew = editingId is null;
            if (isNew)
                await GoalService.CreateAsync(input);
            else
                await GoalService.UpdateAsync(editingId!.Value, input);

            showForm = false;
            message = isNew ? "Meta creada." : "Meta actualizada.";
            error = null;
            await LoadAsync();
            celebrationChecked = false;   // a goal that was just reached can celebrate
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            formError = ex.Message;
        }
    }

    private void CloseForm()
    {
        showForm = false;
        formError = null;
    }

    // ---------- Delete ----------

    private void AskDelete(GoalDto goal)
    {
        ClearMessages();
        pendingDelete = goal;
        deleteMessage = $"¿Eliminar la meta \"{goal.Name}\"? Tus gastos no se tocan; solo se deja de seguir esta meta.";
        confirmDelete = true;
    }

    private async Task DeleteAsync()
    {
        if (pendingDelete is null)
            return;

        var goal = pendingDelete;
        await RunAsync(async () =>
        {
            await GoalService.DeleteAsync(goal.Id);
            message = "Meta eliminada.";
            await LoadAsync();
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            error = ex.Message;
        }
    }

    private void ClearMessages()
    {
        error = null;
        message = null;
        formError = null;
    }
}
