@page "/"
@using ExpenseTracker.Core.Application.DTOs.Budget
@using ExpenseTracker.Core.Application.DTOs.Dashboard
@using ExpenseTracker.Core.Application.DTOs.Goals
@using ExpenseTracker.Core.Application.Helpers
@using ExpenseTracker.Core.Application.Services
@using ExpenseTracker.Core.Domain.Enums
@using ExpenseTracker.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject DashboardService DashboardService
@inject CurrencyService CurrencyService
@inject AuthenticationStateProvider AuthState
@inject ChartAnimationState ChartAnimation

<PageTitle>Inicio · Expense Tracker</PageTitle>

<PageHeader Title="@Greeting" Subtitle="@(data is null ? null : $"{UiLabels.MonthName(data.Month).ToLower()} {data.Year}")" />

<ErrorAlert @bind-Message="error" />

@if (loading)
{
    <div class="home-skeleton">
        <div class="home-skeleton__chart"><Skeleton Circle="true" Width="220px" Height="220px" /></div>
        <div class="home-skeleton__cards">
            <Skeleton Height="5.5rem" />
            <Skeleton Height="5.5rem" />
            <Skeleton Height="5.5rem" />
        </div>
    </div>
    <Skeleton Lines="4" Height="2rem" />
}
else if (data is not null)
{
    @if (data.IsDeficit)
    {
        <InlineAlert Tone="InlineAlert.AlertTone.Danger" Class="mb-4">
            <strong>Déficit de <MoneyText Amount="data.DeficitAmount" Currency="baseCurrency" /> este mes.</strong>
            Lo gastado y lo comprometido supera tus ingresos.
        </InlineAlert>
    }

    @if (!data.HasIncome)
    {
        <EmptyState Icon="@Icons.EmptyIncomes" Title="Empecemos"
                    Description="Todavía no hay ingresos este mes, así que no hay nada que repartir. Sigue estos pasos:">
            <Action>
                <div class="stack">
                    <ol class="start-steps">
                        <li><a href="/ingresos">Configura tus ingresos</a></li>
                        <li><a href="/gastos">Registra tus gastos</a></li>
                        <li><a href="/plan">Arma tu plan</a></li>
                    </ol>
                    <div><a href="/ingresos" class="btn-app btn-app--primary btn-app--md">Configurar ingresos</a></div>
                </div>
            </Action>
        </EmptyState>
    }
    else
    {
        <div class="home-summary">
            <div class="home-summary__chart">
                <PieChart Slices="Slices" Currency="baseCurrency" ShowLegend="false" Animate="animateChart"
                          CenterLabel="@(data.IsDeficit ? "Déficit" : "Disponible")"
                          CenterValue="@MoneyFormatter.Format(data.IsDeficit ? data.DeficitAmount : data.Available, baseCurrency)" />
            </div>
            <div class="home-summary__cards">
                <StatCard Label="Disponible" Amount="data.Available" Currency="baseCurrency" Tone="StatCard.StatTone.Available" />
                <StatCard Label="Gastado" Amount="data.Spent" Currency="baseCurrency" Tone="StatCard.StatTone.Spent" />
                <StatCard Label="Comprometido" Amount="data.Committed" Currency="baseCurrency" Tone="StatCard.StatTone.Committed" />
                <p class="home-summary__note">
                    Ingresos del mes: <MoneyText Amount="data.Income" Currency="baseCurrency" />.
                    Comprometido son los gastos y cuotas de este mes que aún no llegan a su fecha.
                </p>
            </div>
        </div>
    }

    @if (ShowSections)
    {
        <div class="home-sections">
            <section aria-labelledby="home-upcoming">
                <div class="home-section__head">
                    <h2 id="home-upcoming">Próximos pagos</h2>
                    <a href="/gastos" class="home-section__link">Ver todo <AppIcon Name="@Icons.Next" Size="14" /></a>
                </div>
                @if (data.UpcomingPayments.Count == 0)
                {
                    <p class="home-section__empty">No tienes pagos en los próximos 7 días.</p>
                }
                else
                {
                    <ul class="home-list">
                        @foreach (var payment in data.UpcomingPayments)
                        {
                            <li class="upcoming">
                                <span class="upcoming__date">@UiLabels.ShortDate(payment.Date)</span>
                                <span class="upcoming__name">
                                    <AppIcon Name="@(payment.DebtId is not null || payment.IsDebt ? Icons.Debts : Icons.Recurring)" Size="14"
                                             Label="@(payment.DebtId is not null || payment.IsDebt ? "Cuota de deuda" : "Gasto recurrente")" Class="upcoming__icon" />
                                    @if (payment.DebtId is not null)
                                    {
                                        <a href="/deudas/@payment.DebtId" class="upcoming__text">@payment.Name</a>
                                    }
                                    else
                                    {
                                        <span class="upcoming__text">@payment.Name</span>
                                    }
                                    @if (payment.IsOverdue)
                                    {
                                        <Badge Tone="Badge.BadgeTone.Red">Vencida</Badge>
                                    }
                                </span>
                                <MoneyText Amount="payment.OriginalAmount" Currency="payment.Currency" />
                            </li>
                        }
                    </ul>
                }
            </section>

            <section aria-labelledby="home-plan">
                <div class="home-section__head">
                    <h2 id="home-plan">Plan</h2>
                    <a href="/plan" class="home-section__link">Ver todo <AppIcon Name="@Icons.Next" Size="14" /></a>
                </div>
                @if (!data.HasPlan)
                {
                    <p class="home-section__empty">
                        Aún no tienes un plan. <a href="/plan">Reparte tus ingresos por categoría</a>.
                    </p>
                }
                else
                {
                    <ul class="home-list">
                        @foreach (var category in data.PlanHighlights)
                        {
                            <li>
                                <div class="meter__head">
                                    <span class="meter__name">
                                        <AppIcon Name="@PlanBars.HealthIcon(category.Health)" Size="14" Class="@PlanBars.HealthClass(category.Health)" />
                                        @category.CategoryName
                                    </span>
                                    <span class="meter__figures">
                                        <MoneyText Amount="category.Spent + category.Pending" Currency="baseCurrency" /> de
                                        <MoneyText Amount="category.Assigned" Currency="baseCurrency" />
                                    </span>
                                </div>
                                <ProgressBar Segments="PlanBars.Segments(category)" Marker="PlanBars.EstimateMarker(category)" MarkerLabel="Estimado a fin de mes" Limit="PlanBars.LimitMarker(category)" LimitLabel="Límite asignado"
                                             Height="6" Label="@PlanBars.Label(category)" />
                                <span class="sr-only">@PlanBars.HealthText(category.Health)</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section aria-labelledby="home-goals">
                <div class="home-section__head">
                    <h2 id="home-goals">Metas</h2>
                    <a href="/metas" class="home-section__link">Ver todo <AppIcon Name="@Icons.Next" Size="14" /></a>
                </div>
                @if (data.Goals.Count == 0)
                {
                    <p class="home-section__empty">
                        Aún no tienes metas. <a href="/metas">Crea la primera</a>.
                    </p>
                }
                else
                {
                    <ul class="home-list">
                        @foreach (var goal in data.Goals)
                        {
                            <li>
                                <div class="meter__head">
                                    <span class="meter__name">@goal.Name</span>
                                    <span class="meter__figures">@goal.ProgressPercent.ToString("0.#") %</span>
                                </div>
                                <ProgressBar Percent="goal.ProgressPercent" ColorVar="@GoalBar(goal.State)" Height="6"
                                             Label="@($"{goal.ProgressPercent:0.#}% de {goal.Name}")" />
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <div class="home-forecast">
            <span>
                Gasto estimado del próximo mes:
                <strong><MoneyText Amount="data.NextMonthEstimate" Currency="baseCurrency" /></strong>
            </span>
            <a href="/estimaciones" class="home-section__link">Ver estimaciones <AppIcon Name="@Icons.Next" Size="14" /></a>
        </div>
    }
}

@code {
    private bool loading = true;
    private bool animateChart;
    private string? error;
    private string? userName;
    private Currency baseCurrency = Currency.DOP;
    private DashboardDto? data;

    private string Greeting
    {
        get
        {
            var hour = DateTime.Now.Hour;
            var salutation = hour < 12 ? "Buenos días" : hour < 19 ? "Buenas tardes" : "Buenas noches";
            return string.IsNullOrEmpty(userName) ? salutation : $"{salutation}, {userName}";
        }
    }

    private List<PieSlice> Slices => data is null
        ? new List<PieSlice>()
        : new List<PieSlice>
        {
            new() { Label = "Gastado", Value = data.Spent, Color = "var(--color-spent)" },
            new() { Label = "Comprometido", Value = data.Committed, Color = "var(--color-committed)" },
            new() { Label = "Disponible", Value = data.Available, Color = "var(--color-available)" }
        };

    // A brand-new user only sees the empty state until there is something to show.
    private bool ShowSections => data is not null
        && (data.HasIncome || data.UpcomingPayments.Count > 0 || data.HasPlan || data.Goals.Count > 0);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var identity = state.User.Identity?.Name;
            userName = identity is null ? null : identity.Split('@')[0];

            baseCurrency = await CurrencyService.GetBaseCurrencyAsync();
            data = await DashboardService.GetAsync();
            animateChart = ChartAnimation.ShouldAnimate("home-donut");
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            error = ex.Message;
        }

        loading = false;
    }

    private static string GoalBar(GoalState state) => state switch
    {
        GoalState.Behind => "--color-warning",
        GoalState.Missed => "--color-spent",
        GoalState.NotStarted => "--color-text-subtle",
        _ => "--color-available"
    };
}
