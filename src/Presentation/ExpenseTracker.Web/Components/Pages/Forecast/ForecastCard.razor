@using ExpenseTracker.Core.Application.DTOs.Forecast
@using ExpenseTracker.Core.Domain.Enums
@using ExpenseTracker.Web.Services

<StatCard Label="@Title" Amount="Data.TotalExpenses" Currency="BaseCurrency" Large="true" Class="forecast-card">
    <p class="forecast-card__caption">gasto estimado · @Data.From.ToString("d") – @Data.To.ToString("d")</p>

    <dl class="forecast-card__figures">
        <div>
            <dt>Ingreso estimado</dt>
            <dd><MoneyText Amount="Data.ProjectedIncome" Currency="BaseCurrency" /></dd>
        </div>
        <div>
            <dt>Balance</dt>
            <dd class="@(Data.Balance < 0 ? "forecast-card__balance--negative" : "forecast-card__balance--positive")">
                <AppIcon Name="@(Data.Balance < 0 ? Icons.TrendDown : Icons.TrendUp)" Size="16" />
                <MoneyText Amount="Data.Balance" Currency="BaseCurrency" />
                <span class="sr-only">@(Data.Balance < 0 ? "(déficit)" : "(a favor)")</span>
            </dd>
        </div>
    </dl>

    @if (Data.Months.Count == 0)
    {
        <p class="text-muted">No queda tiempo en este periodo.</p>
    }
    else
    {
        <button type="button" class="forecast-card__toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@panelId"
                @onclick="() => expanded = !expanded">
            <AppIcon Name="chevron-down" Size="14" Class="@(expanded ? "forecast-card__chevron forecast-card__chevron--open" : "forecast-card__chevron")" />
            @(expanded ? "Ocultar desglose" : "Ver desglose")
        </button>

        <div id="@panelId" class="forecast-card__detail" hidden="@(!expanded)">
            @if (expanded)
            {
                <h3>Recurrentes <span class="text-muted">· <MoneyText Amount="Data.RecurringTotal" Currency="BaseCurrency" /></span></h3>
                @if (Data.RecurringItems.Count == 0)
                {
                    <p class="text-muted">Sin gastos recurrentes en este periodo.</p>
                }
                else
                {
                    <ul class="forecast-list">
                        @foreach (var item in Data.RecurringItems)
                        {
                            <li>
                                <span>@item.Name <span class="text-muted">· @item.CategoryName@(item.Occurrences > 1 ? $" · {item.Occurrences} veces" : "")</span></span>
                                <MoneyText Amount="item.Amount" Currency="BaseCurrency" />
                            </li>
                        }
                    </ul>
                }

                <h3>Deudas <span class="text-muted">· <MoneyText Amount="Data.DebtsTotal" Currency="BaseCurrency" /></span></h3>
                @if (Data.DebtItems.Count == 0)
                {
                    <p class="text-muted">Sin cuotas de deuda en este periodo.</p>
                }
                else
                {
                    <ul class="forecast-list">
                        @foreach (var item in Data.DebtItems)
                        {
                            <li>
                                <span>@item.Name <span class="text-muted">· @item.Occurrences @(item.Occurrences == 1 ? "cuota" : "cuotas")</span></span>
                                <MoneyText Amount="item.Amount" Currency="BaseCurrency" />
                            </li>
                        }
                    </ul>
                }

                <h3>Variables <span class="text-muted">· <MoneyText Amount="Data.VariablesTotal" Currency="BaseCurrency" /></span></h3>
                @if (Data.VariableItems.Count == 0)
                {
                    <p class="text-muted">Sin historial ni plan para estimar gastos variables.</p>
                }
                else
                {
                    <ul class="forecast-list">
                        @foreach (var item in Data.VariableItems)
                        {
                            <li>
                                <span class="forecast-list__who">
                                    <CategoryChip Name="@item.CategoryName" Color="@item.CategoryColor" />
                                    @if (item.Basis == VariableBasis.Plan)
                                    {
                                        <Badge Tone="Badge.BadgeTone.Gray">Plan</Badge>
                                    }
                                </span>
                                <MoneyText Amount="item.Amount" Currency="BaseCurrency" />
                            </li>
                        }
                    </ul>
                    <p class="forecast-note">@VariablesNote</p>
                }

                @if (ShowMonths && Data.Months.Count > 1)
                {
                    <h3>Mes a mes</h3>
                    <div class="amort forecast-table" tabindex="0" role="region" aria-label="Estimación mes a mes">
                        <table class="amort__table">
                            <thead>
                                <tr>
                                    <th scope="col">Mes</th>
                                    <th scope="col" class="num">Recurr.</th>
                                    <th scope="col" class="num">Deudas</th>
                                    <th scope="col" class="num">Variab.</th>
                                    <th scope="col" class="num">Gastos</th>
                                    <th scope="col" class="num">Ingresos</th>
                                    <th scope="col" class="num">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Data.Months)
                                {
                                    <tr>
                                        <td>@UiLabels.ShortMonthName(m.Month)@(m.IsPartial ? "*" : "")</td>
                                        <td class="num"><MoneyText Amount="m.Recurring" Currency="BaseCurrency" /></td>
                                        <td class="num"><MoneyText Amount="m.Debts" Currency="BaseCurrency" /></td>
                                        <td class="num"><MoneyText Amount="m.Variables" Currency="BaseCurrency" /></td>
                                        <td class="num"><MoneyText Amount="m.TotalExpenses" Currency="BaseCurrency" /></td>
                                        <td class="num"><MoneyText Amount="m.Income" Currency="BaseCurrency" /></td>
                                        <td class="num @(m.Balance < 0 ? "forecast-card__balance--negative" : "forecast-card__balance--positive")"><MoneyText Amount="m.Balance" Currency="BaseCurrency" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Data.Months.Any(m => m.IsPartial))
                    {
                        <p class="forecast-note">* Mes parcial: solo se cuenta lo que queda por delante.</p>
                    }
                }
            }
        </div>
    }
</StatCard>

@code {
    private readonly string panelId = $"forecast-{Guid.NewGuid():N}";

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public ForecastDto Data { get; set; } = new();

    [Parameter]
    public Currency BaseCurrency { get; set; } = Currency.DOP;

    /// <summary>Show the month-by-month table (for ranges longer than a month).</summary>
    [Parameter]
    public bool ShowMonths { get; set; }

    private bool expanded;

    private string VariablesNote => (Data.UsesHistory, Data.UsesPlan) switch
    {
        (true, true) => "Variables estimadas con el promedio de los últimos 3 meses (o con tu Plan donde no hay historial).",
        (false, true) => "Variables estimadas con tu Plan, porque aún no hay historial.",
        _ => "Variables estimadas con el promedio de los últimos 3 meses."
    };
}
