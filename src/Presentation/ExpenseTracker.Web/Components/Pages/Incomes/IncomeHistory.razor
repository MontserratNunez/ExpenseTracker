@using ExpenseTracker.Core.Application.DTOs.Incomes
@using ExpenseTracker.Core.Application.Helpers
@using ExpenseTracker.Core.Application.Services
@using ExpenseTracker.Core.Domain.Enums
@using ExpenseTracker.Web.Services
@inject IncomeService IncomeService

@* The revisions of a source and the explicit correction of its history, with the effect shown before saving. *@
<AppModal IsOpen="@(Source is not null)" Title="@($"Historial de {Source?.Name}")" Width="OverlayWidth.Md" OnClose="OnClose">
    <ChildContent>
        @if (Source is not null)
        {
            <ul class="income-history" aria-label="Revisiones">
                @foreach (var revision in Source.Revisions.AsEnumerable().Reverse())
                {
                    <li>
                        <span>Desde @UiLabels.MonthYear(revision.EffectiveFrom)</span>
                        <strong><MoneyText Amount="revision.Amount" Currency="revision.Currency" /></strong>
                        <span class="text-muted">@UiLabels.FrequencyName(revision.Frequency)</span>
                        @if (revision.Note is not null)
                        {
                            <span class="text-muted">@revision.Note</span>
                        }
                    </li>
                }
            </ul>

            @if (!correcting)
            {
                <AppButton Variant="AppButton.ButtonVariant.Secondary" Icon="@Icons.History" OnClick="StartCorrection">Corregir historial</AppButton>
            }
            else
            {
                <fieldset class="income-correction">
                    <legend>Corregir historial</legend>
                    <p class="form-field__hint">
                        Para registrar un monto anterior o arreglar un error. Es la forma de cambiar meses pasados.
                    </p>
                    <ErrorAlert Message="@error" />

                    <div class="form-field">
                        <span class="form-field__label">Desde</span>
                        <MonthYearSelect Label="Corregir desde" Value="from" FirstYear="CurrentMonth.Year - 5"
                                         ValueChanged="month => Change(() => from = month)" />
                    </div>
                    <div class="form-field">
                        <label class="plan-check">
                            <input type="checkbox" checked="@hasUntil" @onchange="e => Change(() => hasUntil = e.Value is true)" />
                            Hasta un mes concreto (si no, hasta el siguiente cambio)
                        </label>
                        @if (hasUntil)
                        {
                            <MonthYearSelect Label="Corregir hasta" Value="until" FirstYear="CurrentMonth.Year - 5"
                                             ValueChanged="month => Change(() => until = month)" />
                        }
                    </div>
                    <div class="form-field">
                        <label class="form-field__label" for="correction-amount">Monto correcto</label>
                        <input id="correction-amount" class="field" inputmode="decimal" value="@amountText"
                               @oninput="e => Change(() => amountText = e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-field__label" for="correction-currency">Moneda del monto</label>
                            <select id="correction-currency" class="field" value="@currency"
                                    @onchange="e => Change(() => currency = Enum.Parse<Currency>(e.Value!.ToString()!))">
                                @foreach (var option in Enum.GetValues<Currency>())
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-field__label" for="correction-frequency">Frecuencia del monto</label>
                            <select id="correction-frequency" class="field" value="@frequency"
                                    @onchange="e => Change(() => frequency = Enum.Parse<Frequency>(e.Value!.ToString()!))">
                                @foreach (var option in Enum.GetValues<Frequency>())
                                {
                                    <option value="@option">@UiLabels.FrequencyName(option)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-field">
                        <label class="form-field__label" for="correction-note">Nota (opcional)</label>
                        <input id="correction-note" class="field" maxlength="200" @bind="note" />
                    </div>

                    @if (preview is not null)
                    {
                        <InlineAlert Tone="InlineAlert.AlertTone.Warning" Class="mb-0">
                            @(preview.Warning ?? "No cambia ningún mes pasado.")
                        </InlineAlert>
                    }
                </fieldset>
            }
        }
    </ChildContent>
    <Footer>
        <AppButton Variant="AppButton.ButtonVariant.Ghost" OnClick="() => OnClose.InvokeAsync()">Listo</AppButton>
        @if (correcting)
        {
            @if (preview is null)
            {
                <AppButton OnClick="PreviewAsync">Ver efecto</AppButton>
            }
            else
            {
                <AppButton OnClick="SaveAsync">Guardar corrección</AppButton>
            }
        }
    </Footer>
</AppModal>

@code {
    /// <summary>The source shown; null closes the dialog.</summary>
    [Parameter]
    public IncomeSourceDto? Source { get; set; }

    [Parameter]
    public DateOnly CurrentMonth { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Raised after a correction was saved.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    private int? shownSourceId;
    private bool correcting;
    private DateOnly from;
    private DateOnly until;
    private bool hasUntil;
    private string amountText = string.Empty;
    private Currency currency;
    private Frequency frequency;
    private string? note;
    private string? error;
    private PastImpactDto? preview;

    protected override void OnParametersSet()
    {
        if (shownSourceId == Source?.Id)
            return;

        shownSourceId = Source?.Id;
        correcting = false;
    }

    private void StartCorrection()
    {
        var first = Source!.Revisions[0];
        correcting = true;
        from = first.EffectiveFrom;
        until = CurrentMonth.AddMonths(-1);
        hasUntil = false;
        amountText = MoneyParser.Format(first.Amount);
        currency = first.Currency;
        frequency = first.Frequency;
        note = null;
        error = null;
        preview = null;
    }

    // The effect shown belongs to the values it was calculated with.
    private void Change(Action change)
    {
        change();
        preview = null;
        error = null;
    }

    private IncomeRevisionInput? BuildInput()
    {
        if (!MoneyParser.TryParse(amountText, out var amount, out var parseError))
        {
            error = parseError;
            return null;
        }

        return new IncomeRevisionInput
        {
            EffectiveFrom = from,
            Until = hasUntil ? until : null,
            Amount = amount,
            Currency = currency,
            Frequency = frequency,
            Note = note
        };
    }

    private Task PreviewAsync() => RunAsync(async input => preview = await IncomeService.PreviewCorrectionAsync(Source!.Id, input));

    private Task SaveAsync() => RunAsync(async input =>
    {
        await IncomeService.CorrectHistoryAsync(Source!.Id, input);
        correcting = false;
        await OnSaved.InvokeAsync();
    });

    private async Task RunAsync(Func<IncomeRevisionInput, Task> action)
    {
        error = null;
        if (BuildInput() is not { } input)
            return;

        try
        {
            await action(input);
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            error = ex.Message;
        }
    }
}
