@page "/ingresos"
@using ExpenseTracker.Core.Application.DTOs.Incomes
@using ExpenseTracker.Core.Application.Interfaces
@using ExpenseTracker.Core.Application.Services
@using ExpenseTracker.Core.Domain.Enums
@using ExpenseTracker.Web.Services
@inject IncomeService IncomeService
@inject CurrencyService CurrencyService
@inject IDateProvider DateProvider

<PageTitle>Ingresos</PageTitle>

<PageHeader Title="Ingresos">
    <Actions>
        @if (tab == Tab.Recurring)
        {
            <AppButton OnClick="StartCreateSource" Icon="@Icons.Add" Disabled="@loading">Nueva fuente</AppButton>
        }
        else
        {
            <AppButton OnClick="StartCreateOneTime" Icon="@Icons.Add" Disabled="@loading">Nuevo ingreso</AppButton>
        }
    </Actions>
</PageHeader>

<div class="tabs" role="tablist" aria-label="Tipo de ingreso" @onkeydown="OnTabKeyDown">
    <button type="button" role="tab" id="tab-recurring" class="tabs__tab @(tab == Tab.Recurring ? "tabs__tab--active" : null)"
            aria-selected="@(tab == Tab.Recurring ? "true" : "false")" aria-controls="income-panel" tabindex="@(tab == Tab.Recurring ? 0 : -1)"
            @onclick="() => tab = Tab.Recurring">Fuentes recurrentes</button>
    <button type="button" role="tab" id="tab-onetime" class="tabs__tab @(tab == Tab.OneTime ? "tabs__tab--active" : null)"
            aria-selected="@(tab == Tab.OneTime ? "true" : "false")" aria-controls="income-panel" tabindex="@(tab == Tab.OneTime ? 0 : -1)"
            @onclick="() => tab = Tab.OneTime">Ingresos únicos</button>
</div>

<ErrorAlert @bind-Message="error" />
<SuccessToast Message="@message" />

<div id="income-panel" role="tabpanel" aria-labelledby="@(tab == Tab.Recurring ? "tab-recurring" : "tab-onetime")">
@if (loading)
{
    <Skeleton Lines="4" Height="3rem" />
}
else if (tab == Tab.Recurring)
{
    @if (recurringTotal is not null)
    {
        <div class="income-total">
            <StatCard Label="Total mensual equivalente" Amount="recurringTotal.Value" Currency="baseCurrency" Large="true" Tone="StatCard.StatTone.Available" />
        </div>
    }

    @if (sources.Count == 0)
    {
        <EmptyState Icon="@Icons.EmptyIncomes" Title="Aún no tienes fuentes de ingreso" Description="Agrega tu sueldo para empezar.">
            <Action><AppButton OnClick="StartCreateSource" Icon="@Icons.Add">Nueva fuente</AppButton></Action>
        </EmptyState>
    }
    else
    {
        <div class="income-grid">
            @foreach (var source in sources)
            {
                var s = source;
                var status = SourceStatus(s);
                <article class="card-app income-card @(status.Active ? null : "income-card--muted")">
                    <header class="income-card__head">
                        <h2>@s.Name</h2>
                        <DropdownMenu AriaLabel="@($"Acciones de {s.Name}")" Items="SourceMenu(s)" />
                    </header>
                    <div class="income-card__amount"><MoneyText Amount="s.Amount" Currency="s.Currency" /></div>
                    <div class="income-card__meta">
                        <Badge Tone="Badge.BadgeTone.Blue" Icon="@Icons.Recurring">@UiLabels.FrequencyName(s.Frequency)</Badge>
                        <Badge Tone="status.Tone" Icon="@status.Icon">@status.Text</Badge>
                    </div>
                </article>
            }
        </div>
    }
}
else
{
    <div class="income-month">
        <MonthNavigator Year="year" Month="month" OnChange="OnMonthChanged" />
        @if (monthly is not null)
        {
            <p class="income-month__total">
                Ingresos de @UiLabels.MonthName(month).ToLower() @year:
                <strong><MoneyText Amount="monthly.Total" Currency="baseCurrency" /></strong>
                <span class="text-muted">
                    (recurrentes <MoneyText Amount="monthly.RecurringTotal" Currency="baseCurrency" /> +
                    únicos <MoneyText Amount="monthly.OneTimeTotal" Currency="baseCurrency" />)
                </span>
            </p>
        }
    </div>

    @if (oneTime.Count == 0)
    {
        <EmptyState Icon="@Icons.EmptyIncomes" Title="No hay ingresos únicos en este mes" Description="Un bono o un pago extra cuenta solo en el mes en que lo recibes.">
            <Action><AppButton OnClick="StartCreateOneTime" Icon="@Icons.Add">Nuevo ingreso</AppButton></Action>
        </EmptyState>
    }
    else
    {
        <DayGroupedList TItem="OneTimeIncomeDto" Items="oneTime" DateOf="i => i.Date" AmountOf="i => i.AmountInBase" Currency="baseCurrency">
            <ItemTemplate Context="i">
                <button type="button" class="exp-row__main" @onclick="() => StartEditOneTime(i)">
                    <span class="income-disc" aria-hidden="true"><AppIcon Name="@Icons.Incomes" Size="16" /></span>
                    <span class="exp-row__text">
                        <span class="exp-row__name">@i.Description</span>
                        <span class="exp-row__category">Ingreso #@i.Id</span>
                    </span>
                    <span class="exp-row__amount">
                        <MoneyText Amount="i.Amount" Currency="i.Currency" />
                        @if (i.Currency != baseCurrency)
                        {
                            <span class="exp-row__converted">(<MoneyText Amount="i.AmountInBase" Currency="baseCurrency" />)</span>
                        }
                    </span>
                </button>
                <div class="exp-row__menu">
                    <DropdownMenu AriaLabel="Más acciones" Items="OneTimeMenu(i)" />
                </div>
            </ItemTemplate>
        </DayGroupedList>
    }
}
</div>

<IncomeSourceForm Visible="showSourceForm" Title="@(editingSourceId is null ? "Nueva fuente de ingreso" : "Editar fuente de ingreso")"
                  Model="sourceInput" Error="@formError" OnSave="SaveSourceAsync" OnCancel="CloseForms" />

<OneTimeIncomeForm Visible="showOneTimeForm" Title="@(editingOneTimeId is null ? "Nuevo ingreso único" : "Editar ingreso único")"
                   Model="oneTimeInput" Error="@formError" OnSave="SaveOneTimeAsync" OnCancel="CloseForms" />

<ConfirmDialog @bind-Visible="confirmDelete" Title="Eliminar" Message="@deleteMessage" ConfirmText="Eliminar" OnConfirm="DeleteAsync" />

@code {
    private enum Tab { Recurring, OneTime }

    private Tab tab = Tab.Recurring;
    private bool loading = true;
    private string? error;
    private string? message;
    private string? formError;

    private Currency baseCurrency = Currency.DOP;
    private List<IncomeSourceDto> sources = new();
    private decimal? recurringTotal;
    private List<OneTimeIncomeDto> oneTime = new();
    private MonthlyIncomeDto? monthly;
    private int year;
    private int month;

    private bool showSourceForm;
    private int? editingSourceId;
    private IncomeSourceInput sourceInput = new();

    private bool showOneTimeForm;
    private int? editingOneTimeId;
    private OneTimeIncomeInput oneTimeInput = new();

    private bool confirmDelete;
    private string deleteMessage = string.Empty;
    private Func<Task>? pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        var today = DateProvider.Today;
        year = today.Year;
        month = today.Month;

        await RunAsync(LoadAsync);
        loading = false;
    }

    private async Task LoadAsync()
    {
        baseCurrency = await CurrencyService.GetBaseCurrencyAsync();
        sources = await IncomeService.ListSourcesAsync();
        oneTime = await IncomeService.ListOneTimeAsync(year, month);

        // Totals need exchange rates; a missing rate must not hide the lists.
        try
        {
            recurringTotal = await IncomeService.GetRecurringMonthlyTotalAsync();
            monthly = await IncomeService.GetMonthlyIncomeAsync(year, month);
        }
        catch (InvalidOperationException ex)
        {
            recurringTotal = null;
            monthly = null;
            error = ex.Message;
        }
    }

    private async Task OnMonthChanged((int Year, int Month) value)
    {
        year = value.Year;
        month = value.Month;
        message = null;
        await RunAsync(LoadAsync);
    }

    private (string Text, Badge.BadgeTone Tone, string? Icon, bool Active) SourceStatus(IncomeSourceDto s)
    {
        var today = DateProvider.Today;
        if (!s.IsActive) return ("Inactiva", Badge.BadgeTone.Gray, null, false);
        if (s.EndDate is not null && s.EndDate < today) return ("Finalizada", Badge.BadgeTone.Gray, null, false);
        if (s.StartDate > today) return ("Pendiente de inicio", Badge.BadgeTone.Amber, Icons.Pending, true);
        return ("Activa", Badge.BadgeTone.Green, Icons.Paid, true);
    }

    private IReadOnlyList<DropdownMenuItem> SourceMenu(IncomeSourceDto s) => new[]
    {
        new DropdownMenuItem("Editar", Icons.Edit, EventCallback.Factory.Create(this, () => StartEditSource(s))),
        new DropdownMenuItem("Eliminar", Icons.Delete, EventCallback.Factory.Create(this, () => AskDeleteSource(s)), danger: true)
    };

    private IReadOnlyList<DropdownMenuItem> OneTimeMenu(OneTimeIncomeDto i) => new[]
    {
        new DropdownMenuItem("Editar", Icons.Edit, EventCallback.Factory.Create(this, () => StartEditOneTime(i))),
        new DropdownMenuItem("Eliminar", Icons.Delete, EventCallback.Factory.Create(this, () => AskDeleteOneTime(i)), danger: true)
    };

    // Left and right arrows move between the two tabs, as the tab pattern expects.
    private void OnTabKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowLeft" or "ArrowRight")
            tab = tab == Tab.Recurring ? Tab.OneTime : Tab.Recurring;
    }

    // ---------- Recurring sources ----------

    private void StartCreateSource()
    {
        ClearMessages();
        editingSourceId = null;
        sourceInput = new IncomeSourceInput { Currency = baseCurrency, StartDate = DateProvider.Today };
        showSourceForm = true;
    }

    private void StartEditSource(IncomeSourceDto s)
    {
        ClearMessages();
        editingSourceId = s.Id;
        sourceInput = new IncomeSourceInput
        {
            Name = s.Name,
            Amount = s.Amount,
            Currency = s.Currency,
            Frequency = s.Frequency,
            StartDate = s.StartDate,
            EndDate = s.EndDate,
            IsActive = s.IsActive
        };
        showSourceForm = true;
    }

    private async Task SaveSourceAsync()
    {
        var isNew = editingSourceId is null;
        await SaveFormAsync(async () =>
        {
            if (isNew)
                await IncomeService.CreateSourceAsync(sourceInput);
            else
                await IncomeService.UpdateSourceAsync(editingSourceId!.Value, sourceInput);
            message = isNew ? "Fuente de ingreso creada." : "Fuente de ingreso actualizada.";
        });
    }

    private void AskDeleteSource(IncomeSourceDto s)
    {
        ClearMessages();
        deleteMessage = $"¿Eliminar la fuente \"{s.Name}\"? Dejará de contar en todos los meses, incluidos los pasados.";
        pendingDelete = async () =>
        {
            await IncomeService.DeleteSourceAsync(s.Id);
            message = "Fuente de ingreso eliminada.";
        };
        confirmDelete = true;
    }

    // ---------- One-time income ----------

    private void StartCreateOneTime()
    {
        ClearMessages();
        editingOneTimeId = null;
        var today = DateProvider.Today;
        var inShownMonth = today.Year == year && today.Month == month;
        oneTimeInput = new OneTimeIncomeInput
        {
            Currency = baseCurrency,
            Date = inShownMonth ? today : new DateOnly(year, month, 1)
        };
        showOneTimeForm = true;
    }

    private void StartEditOneTime(OneTimeIncomeDto i)
    {
        ClearMessages();
        editingOneTimeId = i.Id;
        oneTimeInput = new OneTimeIncomeInput
        {
            Description = i.Description,
            Amount = i.Amount,
            Currency = i.Currency,
            Date = i.Date
        };
        showOneTimeForm = true;
    }

    private async Task SaveOneTimeAsync()
    {
        var isNew = editingOneTimeId is null;
        await SaveFormAsync(async () =>
        {
            if (isNew)
                await IncomeService.CreateOneTimeAsync(oneTimeInput);
            else
                await IncomeService.UpdateOneTimeAsync(editingOneTimeId!.Value, oneTimeInput);
            message = isNew ? "Ingreso guardado." : "Ingreso actualizado.";
        });
    }

    private void AskDeleteOneTime(OneTimeIncomeDto i)
    {
        ClearMessages();
        deleteMessage = $"¿Eliminar el ingreso #{i.Id} \"{i.Description}\"?";
        pendingDelete = async () =>
        {
            await IncomeService.DeleteOneTimeAsync(i.Id);
            message = "Ingreso eliminado.";
        };
        confirmDelete = true;
    }

    // ---------- Shared ----------

    private async Task DeleteAsync()
    {
        if (pendingDelete is null)
            return;

        var action = pendingDelete;
        pendingDelete = null;
        await RunAsync(async () =>
        {
            await action();
            await LoadAsync();
        });
    }

    // Keeps the modal open and shows the error inside it when saving fails.
    private async Task SaveFormAsync(Func<Task> save)
    {
        formError = null;
        try
        {
            await save();
            CloseForms();
            error = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            formError = ex.Message;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            error = ex.Message;
        }
    }

    private void CloseForms()
    {
        showSourceForm = false;
        showOneTimeForm = false;
        formError = null;
    }

    private void ClearMessages()
    {
        error = null;
        message = null;
        formError = null;
    }
}
