@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using ExpenseTracker.Infrastructure.Identity.Models

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Datos personales · Expense Tracker</PageTitle>

<h2>Datos personales</h2>
<StatusMessage />
<p class="manage-note">Tu cuenta guarda los datos personales que nos diste. Aquí puedes descargarlos o eliminarlos.</p>
<InlineAlert Tone="InlineAlert.AlertTone.Warning">
    <strong>Eliminar tus datos borra tu cuenta de forma permanente y no se puede deshacer.</strong>
</InlineAlert>
<div class="manage-actions">
    <form action="Account/Manage/DownloadPersonalData" method="post">
        <AntiforgeryToken />
        <AppButton Type="submit" Icon="@Icons.Paid">Descargar mis datos</AppButton>
    </form>
    <a href="Account/Manage/DeletePersonalData" class="btn-app btn-app--danger btn-app--md">Eliminar mis datos</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
