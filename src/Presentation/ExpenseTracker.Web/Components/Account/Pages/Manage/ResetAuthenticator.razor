@page "/Account/Manage/ResetAuthenticator"

@using Microsoft.AspNetCore.Identity
@using ExpenseTracker.Infrastructure.Identity.Models

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResetAuthenticator> Logger

<PageTitle>Restablecer clave de autenticación</PageTitle>

<h2>Restablecer clave de autenticación</h2>
<StatusMessage />
<InlineAlert Tone="InlineAlert.AlertTone.Warning">
    <strong>Si restableces la clave, tu app de autenticación dejará de funcionar hasta que la configures de nuevo.</strong>
    Este proceso desactiva la verificación en dos pasos hasta que verifiques la app. Si no terminas la configuración
    podrías perder el acceso a tu cuenta.
</InlineAlert>
<form @formname="reset-authenticator" @onsubmit="OnSubmitAsync" method="post" class="manage-actions">
    <AntiforgeryToken />
    <AppButton Type="submit" Variant="AppButton.ButtonVariant.Danger">Restablecer clave</AppButton>
</form>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task OnSubmitAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(user, false);
        await UserManager.ResetAuthenticatorKeyAsync(user);
        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has reset their authentication app key.", userId);

        await SignInManager.RefreshSignInAsync(user);

        RedirectManager.RedirectToWithStatus(
            "Account/Manage/EnableAuthenticator",
            "Your authenticator app key has been reset, you will need to configure your authenticator app using the new key.",
            HttpContext);
    }
}
