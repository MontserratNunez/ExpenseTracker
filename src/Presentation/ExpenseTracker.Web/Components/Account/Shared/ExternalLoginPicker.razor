@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using ExpenseTracker.Infrastructure.Identity.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@* Only shown when an external provider (Google, Microsoft...) is configured: otherwise there is nothing to offer. *@
@if (externalLogins.Length > 0)
{
    <div class="account-divider" aria-hidden="true"><span>o</span></div>
    <form action="Account/PerformExternalLogin" method="post" class="account-form">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        @foreach (var provider in externalLogins)
        {
            <button type="submit" class="btn-app btn-app--secondary btn-app--md btn-app--block" name="provider" value="@provider.Name"
                    title="Continuar con @provider.DisplayName">Continuar con @provider.DisplayName</button>
        }
    </form>
}

@code {
    private AuthenticationScheme[] externalLogins = [];

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }
}
