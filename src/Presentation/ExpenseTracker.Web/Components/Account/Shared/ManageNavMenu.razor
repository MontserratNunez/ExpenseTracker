@using Microsoft.AspNetCore.Identity
@using ExpenseTracker.Infrastructure.Identity.Models

@inject SignInManager<ApplicationUser> SignInManager

<div class="subnav">
    <NavLink class="subnav__link" href="Account/Manage" Match="NavLinkMatch.All">Perfil</NavLink>
    <NavLink class="subnav__link" href="Account/Manage/Email">Correo electrónico</NavLink>
    <NavLink class="subnav__link" href="Account/Manage/ChangePassword">Contraseña</NavLink>
    @if (hasExternalLogins)
    {
        <NavLink class="subnav__link" href="Account/Manage/ExternalLogins">Inicios de sesión externos</NavLink>
    }
    <NavLink class="subnav__link" href="Account/Manage/TwoFactorAuthentication">Verificación en dos pasos</NavLink>
    <NavLink class="subnav__link" href="Account/Manage/Passkeys">Passkeys</NavLink>
    <NavLink class="subnav__link" href="Account/Manage/PersonalData">Datos personales</NavLink>
</div>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
