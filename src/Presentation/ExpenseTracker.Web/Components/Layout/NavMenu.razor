@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Expense Tracker</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                @foreach (var item in MenuItems)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="@item.Href" Match="@(item.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                            <span class="bi @item.IconClass" aria-hidden="true"></span> @item.Text
                        </NavLink>
                    </div>
                }

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Cerrar sesión
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Registrarse
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Iniciar sesión
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    private sealed class MenuItem
    {
        public MenuItem(string href, string text, string iconClass)
        {
            Href = href;
            Text = text;
            IconClass = iconClass;
        }

        public string Href { get; }
        public string Text { get; }
        public string IconClass { get; }
    }

    private static readonly MenuItem[] MenuItems =
    {
        new("", "Inicio", "bi-house-door-fill-nav-menu"),
        new("ingresos", "Ingresos", "bi-plus-square-fill-nav-menu"),
        new("gastos", "Gastos", "bi-list-nested-nav-menu"),
        new("deudas", "Deudas", "bi-lock-nav-menu"),
        new("plan", "Plan", "bi-list-nested-nav-menu"),
        new("metas", "Metas", "bi-plus-square-fill-nav-menu"),
        new("estimaciones", "Estimaciones", "bi-list-nested-nav-menu"),
        new("configuracion", "Configuración", "bi-person-badge-nav-menu"),
    };

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

