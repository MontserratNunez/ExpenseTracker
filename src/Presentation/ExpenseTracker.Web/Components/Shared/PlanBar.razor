@using System.Globalization
@using ExpenseTracker.Core.Application.DTOs.Budget

@* Three segments: spent (solid), pending (striped) and a marker line for the month-end estimate. *@
<div class="position-relative" style="height: 16px;">
    <div class="progress" style="height: 16px;" role="img" aria-label="@AriaLabel">
        <div class="progress-bar @SpentClass" style="width: @Pct(Spent)%"></div>
        <div class="progress-bar progress-bar-striped bg-secondary" style="width: @Pct(Pending)%"></div>
    </div>
    @if (Estimated > 0)
    {
        <div class="position-absolute top-0 bottom-0 bg-dark" style="left: @Pct(Estimated)%; width: 2px; margin-left: -1px;"
             title="Estimado a fin de mes"></div>
    }
    @if (Scale > Assigned && Assigned > 0)
    {
        @* The allocation limit, when spending goes beyond it. *@
        <div class="position-absolute top-0 bottom-0 border-start border-2 border-danger" style="left: @Pct(Assigned)%;" title="Límite asignado"></div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public decimal Assigned { get; set; }

    [Parameter]
    public decimal Spent { get; set; }

    [Parameter]
    public decimal Pending { get; set; }

    [Parameter]
    public decimal Estimated { get; set; }

    [Parameter]
    public PlanHealth Health { get; set; }

    // The bar always spans the largest of the allocation and the amounts shown.
    private decimal Scale => Math.Max(Math.Max(Assigned, Spent + Pending), Estimated);

    private string SpentClass => Health switch
    {
        PlanHealth.Red => "bg-danger",
        PlanHealth.Yellow => "bg-warning",
        _ => "bg-success"
    };

    private string Pct(decimal value)
        => (Scale <= 0 ? 0m : Math.Clamp(value / Scale * 100m, 0m, 100m)).ToString("0.##", CultureInfo.InvariantCulture);

    private string AriaLabel => $"Gastado {Spent:N2}, pendiente {Pending:N2}, estimado {Estimated:N2} de {Assigned:N2} asignados";
}
