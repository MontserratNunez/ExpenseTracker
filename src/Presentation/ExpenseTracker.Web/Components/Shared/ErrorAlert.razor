@* A business error shown above the page content, with a close button. *@
<InlineAlert Tone="InlineAlert.AlertTone.Danger" Visible="@(!string.IsNullOrWhiteSpace(Message))" OnDismiss="DismissAsync">@Message</InlineAlert>

@code {
    /// <summary>Business error message (usually the text of an InvalidOperationException).</summary>
    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public EventCallback<string?> MessageChanged { get; set; }

    private Task DismissAsync()
    {
        Message = null;
        return MessageChanged.InvokeAsync(null);
    }
}
