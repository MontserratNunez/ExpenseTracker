<AppModal IsOpen="Visible" Title="@Title" Width="OverlayWidth.Sm" OnClose="CancelAsync">
    <ChildContent>
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            <p class="mb-0">@Message</p>
        }
    </ChildContent>
    <Footer>
        @* The safe choice gets the focus first, so a stray Enter never confirms a deletion. *@
        <AppButton Variant="AppButton.ButtonVariant.Ghost" OnClick="CancelAsync" data-autofocus="true">@CancelText</AppButton>
        <AppButton Variant="ConfirmVariant" OnClick="ConfirmAsync">@ConfirmText</AppButton>
    </Footer>
</AppModal>

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public string Title { get; set; } = "Confirmar";

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string ConfirmText { get; set; } = "Aceptar";

    [Parameter]
    public string CancelText { get; set; } = "Cancelar";

    [Parameter]
    public AppButton.ButtonVariant ConfirmVariant { get; set; } = AppButton.ButtonVariant.Danger;

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task ConfirmAsync()
    {
        await CloseAsync();
        await OnConfirm.InvokeAsync();
    }

    private async Task CancelAsync()
    {
        await CloseAsync();
        await OnCancel.InvokeAsync();
    }

    private async Task CloseAsync()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }
}
