@implements IDisposable
@using ExpenseTracker.Web.Services
@inject ToastService Toasts

<div class="toast-host" aria-live="polite" aria-atomic="false">
    @foreach (var toast in Toasts.Items)
    {
        var t = toast;
        <div class="toast-app toast-app--@t.Kind.ToString().ToLower()" role="status">
            <AppIcon Name="@IconFor(t.Kind)" Size="18" Class="toast-app__icon" />
            <span class="toast-app__text">@t.Message</span>
            @if (t.Action is not null)
            {
                <button type="button" class="toast-app__action" @onclick="() => Toasts.RunActionAsync(t.Id)">@t.ActionText</button>
            }
            <AppButton Variant="AppButton.ButtonVariant.Ghost" Icon="@Icons.Close" AriaLabel="Cerrar" OnClick="() => Toasts.Dismiss(t.Id)" />
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toasts.Changed += OnChanged;

    // Changes can come from a timer thread, so re-render through the component's dispatcher.
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private static string IconFor(ToastKind kind) => kind switch
    {
        ToastKind.Error => Icons.Error,
        ToastKind.Info => Icons.Info,
        _ => Icons.Success
    };

    public void Dispose() => Toasts.Changed -= OnChanged;
}
