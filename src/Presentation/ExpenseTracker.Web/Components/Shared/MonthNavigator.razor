@using ExpenseTracker.Core.Application.Interfaces
@using ExpenseTracker.Web.Services
@inject IDateProvider DateProvider

<div class="month-nav">
    <AppButton Variant="AppButton.ButtonVariant.Ghost" Icon="@Icons.Previous" AriaLabel="Mes anterior" OnClick="Previous" />
    <strong class="month-nav__label" aria-live="polite">@UiLabels.MonthName(Month) @Year</strong>
    <AppButton Variant="AppButton.ButtonVariant.Ghost" Icon="@Icons.Next" AriaLabel="Mes siguiente" Disabled="@(!CanGoNext)" OnClick="Next" />
    @if (ShowCalendar)
    {
        <div class="popover-anchor">
            <AppButton Variant="AppButton.ButtonVariant.Ghost" Icon="@Icons.Calendar" AriaLabel="Elegir mes y año"
                       OnClick="() => pickerOpen = !pickerOpen" />
            <Popover IsOpen="pickerOpen" OnClose="() => pickerOpen = false" AriaLabel="Elegir mes" Class="ymp-popover">
                <YearMonthPicker Year="Year" Month="Month" MaxMonthsAhead="MaxMonthsAhead"
                                 LoadYearTotals="LoadYearTotals" OnSelect="PickAsync" />
            </Popover>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public int Year { get; set; }

    [Parameter, EditorRequired]
    public int Month { get; set; }

    /// <summary>Raised with the new (year, month) when the user moves to another month.</summary>
    [Parameter]
    public EventCallback<(int Year, int Month)> OnChange { get; set; }

    /// <summary>How many months after the current one can be reached.</summary>
    [Parameter]
    public int MaxMonthsAhead { get; set; } = 1;

    /// <summary>Shows the calendar button that opens the year/month popover.</summary>
    [Parameter]
    public bool ShowCalendar { get; set; } = true;

    /// <summary>Gives the 12 monthly totals of a year so the calendar can show how heavy each month was.</summary>
    [Parameter]
    public Func<int, Task<decimal[]>>? LoadYearTotals { get; set; }

    private bool pickerOpen;

    private bool CanGoNext
    {
        get
        {
            var today = DateProvider.Today;
            var limit = today.Year * 12 + today.Month + MaxMonthsAhead;
            return Year * 12 + Month < limit;
        }
    }

    private Task Previous() => MoveAsync(-1);

    private Task Next() => CanGoNext ? MoveAsync(1) : Task.CompletedTask;

    private Task MoveAsync(int delta)
    {
        var index = Year * 12 + (Month - 1) + delta;
        return OnChange.InvokeAsync((index / 12, index % 12 + 1));
    }

    private async Task PickAsync((int Year, int Month) value)
    {
        pickerOpen = false;
        await OnChange.InvokeAsync(value);
    }
}
