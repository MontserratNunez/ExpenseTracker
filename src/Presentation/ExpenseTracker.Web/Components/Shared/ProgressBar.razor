<div class="progress" role="progressbar" aria-valuenow="@Clamped.ToString("0")" aria-valuemin="0" aria-valuemax="100"
     aria-label="@Label" style="height: @(Height)px;">
    <div class="progress-bar @BarClass" style="width: @Clamped.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
</div>

@code {
    /// <summary>Percentage from 0 to 100 (values outside are clamped).</summary>
    [Parameter, EditorRequired]
    public decimal Percent { get; set; }

    [Parameter]
    public string BarClass { get; set; } = "bg-success";

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public int Height { get; set; } = 10;

    private decimal Clamped => Math.Clamp(Percent, 0m, 100m);
}
